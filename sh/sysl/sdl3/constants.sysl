// ### Events (SDL_EVENT_*)
//
// **In SDL's own order, which is worth keeping**: the application events, then the window ones, then
// input by device, then the drops. A number here is never written down — the name is handed to the C
// compiler — so the order buys nothing but a reader being able to find a neighbour.
c const
    EVENT_QUIT:                         u32 = "SDL_EVENT_QUIT"
    EVENT_TERMINATING:                  u32 = "SDL_EVENT_TERMINATING"
    EVENT_LOW_MEMORY:                   u32 = "SDL_EVENT_LOW_MEMORY"
