module sh.sysl.sdl3

import sh.sysl.sdl3.c
import sysl.text.from_cstring
import sysl.buf.{Buf, buf}

// The event queue.
//
// **`SDL_Event` is a union of about thirty structs in 128 bytes**, declared in `c` as the header
// every event begins with and a view struct per variant. An `Event` here is that union with the
// accessors on it: each one reinterprets into the view its field belongs to.
//
// **A field is only meaningful for the matching `kind`.** That is what a union means, and no
// binding can make it otherwise — asking a mouse event for its scancode reads whatever the mouse
// event had at that offset. Match on `kind()` first.

// What an event is. The variants are SDL's `SDL_EVENT_*` values, which is why the ones about
// windows are spelled out rather than nested: they are one flat enumeration in C.
enum EventKind
    // The last window closed, or the platform asked the program to stop.
    Quit

    // ## The application lifecycle
    //
    // **On a desktop these barely fire. On a phone they are the program's whole shape**, because the
    // system rather than the user decides when it stops running: Android delivers them from
    // `onPause`, `onResume`, `onTrimMemory` and `onDestroy`, and iOS from the matching
    // `UIApplicationDelegate` methods.
    //
    // **SDL's header says each of these "must be handled in a callback set with
    // SDL_AddEventWatch()", and that is not advice.** They are delivered synchronously from inside
    // the platform's own callback, on the platform's thread, while the program still has the CPU —
    // and the program may not be given it back. A `DidEnterBackground` seen through `poll_event` is
    // seen after the operating system already stopped scheduling the loop that polls, which on
    // Android can be after the process has been killed. So a program that must save state, or must
    // release the graphics resources a backgrounded app is not allowed to hold, registers
    // `add_event_watch` and does it there.
    //
    // They are still delivered to the queue as well, which is enough for anything that only wants to
    // stop animating.
    Terminating
    LowMemory
    WillEnterBackground
    DidEnterBackground
    WillEnterForeground
    DidEnterForeground

    // The user changed something the whole interface reads. `system_theme()` and
    // `preferred_locales()` answer the new value — neither event carries it, because the setting is
    // asked for rather than delivered.
    LocaleChanged
    SystemThemeChanged

    WindowShown
    WindowHidden
    WindowExposed
    WindowMoved

    // `WindowResized` fires when the logical size changes — a user drag, a programmatic resize.
    // `WindowPixelSizeChanged` fires when the backbuffer's pixel size does, which is the same moment
    // on a 1x display and is also when the window moves between displays of different density. A
    // renderer that owns a sized backbuffer rebuilds it on the second.
    WindowResized
    WindowPixelSizeChanged

    // The window moved to another display, and the scale it should draw at changed. `WindowMoved`
    // fires for an ordinary drag across one desktop; these two fire when the *density* underneath
    // changes — dragging between a laptop's panel and an external monitor, or a phone being handed a
    // new display setting. A program that sized anything from `Window.display_scale` re-reads it
    // here, which is the whole reason to know about them.
    //
    // `window_data1` on a `WindowDisplayChanged` is the new display's id. A scale change carries no
    // payload, because the scale is asked for rather than delivered.
    WindowDisplayChanged
    WindowDisplayScaleChanged

    WindowMinimized
    WindowMaximized
    WindowRestored
    WindowMouseEnter
    WindowMouseLeave
    WindowFocusGained
    WindowFocusLost
    WindowCloseRequested

    KeyDown
    KeyUp

    // Finished text, after the platform's input method has had it. This is what a text field
    // appends; the key events are for shortcuts and movement.
    TextInput

    // An input method's composition in progress — the underlined text a CJK or accent-composing
    // keyboard shows before it commits.
    TextEditing

    MouseMotion
    MouseButtonDown
    MouseButtonUp
    MouseWheel

    // ## Touch
    //
    // A finger on a touchscreen or a trackpad. `FingerCanceled` is the one with no mouse counterpart
    // and the one most easily left out: the system took the gesture away — an incoming call, a
    // notification pulled down, a system back-swipe that started at the edge — and the finger that
    // went down will never come up. A widget tracking a drag has to let go on it, or it stays
    // captured by a finger that is gone.
    //
    // **A program can usually ignore all four.** SDL synthesizes mouse events from touch, so a tap
    // arrives as `MouseButtonDown` with a position already in window coordinates, and that is the
    // whole of the input for anything that only wants taps — it is what `androidkit` does, and the
    // same source then runs on a desktop. These are for what a mouse cannot say: which finger, how
    // many at once, and how hard.
    //
    // **Handling both means handling every tap twice**, so a program that reads these filters the
    // mouse events whose `mouse_which` is `TOUCH_MOUSEID`, or the finger events whose `touch_id`
    // is `MOUSE_TOUCHID`, depending on which pair it would rather keep.
    FingerDown
    FingerUp
    FingerMotion
    FingerCanceled

    // Drag and drop from the desktop onto the window. A drag delivers a `DropBegin`, then one
    // `DropFile` (or `DropText`) per item, then `DropComplete` — only the per-item events carry a
    // payload. SDL owns the string and frees it once the event is handled, so `Event.drop_data`
    // copies it out.
    DropFile
    DropText
    DropBegin
    DropComplete
    DropPosition

    // The first of the range a program's own pushed events live in.
    User

    // Anything SDL delivers that this package does not name — a gamepad, a sensor, a camera. It is
    // an ordinary answer and a program's `match` should have an arm for it.
    Other(code: u32)

    code(self) -> u32
        self match
            Quit -> EVENT_QUIT
            Terminating -> EVENT_TERMINATING
            LowMemory -> EVENT_LOW_MEMORY
            WillEnterBackground -> EVENT_WILL_ENTER_BACKGROUND
            DidEnterBackground -> EVENT_DID_ENTER_BACKGROUND
            WillEnterForeground -> EVENT_WILL_ENTER_FOREGROUND
            DidEnterForeground -> EVENT_DID_ENTER_FOREGROUND
            LocaleChanged -> EVENT_LOCALE_CHANGED
            SystemThemeChanged -> EVENT_SYSTEM_THEME_CHANGED
            WindowShown -> EVENT_WINDOW_SHOWN
            WindowHidden -> EVENT_WINDOW_HIDDEN
            WindowExposed -> EVENT_WINDOW_EXPOSED
            WindowMoved -> EVENT_WINDOW_MOVED
            WindowResized -> EVENT_WINDOW_RESIZED
            WindowPixelSizeChanged -> EVENT_WINDOW_PIXEL_SIZE_CHANGED
            WindowDisplayChanged -> EVENT_WINDOW_DISPLAY_CHANGED
            WindowDisplayScaleChanged -> EVENT_WINDOW_DISPLAY_SCALE_CHANGED
            WindowMinimized -> EVENT_WINDOW_MINIMIZED
            WindowMaximized -> EVENT_WINDOW_MAXIMIZED
            WindowRestored -> EVENT_WINDOW_RESTORED
            WindowMouseEnter -> EVENT_WINDOW_MOUSE_ENTER
            WindowMouseLeave -> EVENT_WINDOW_MOUSE_LEAVE
            WindowFocusGained -> EVENT_WINDOW_FOCUS_GAINED
            WindowFocusLost -> EVENT_WINDOW_FOCUS_LOST
            WindowCloseRequested -> EVENT_WINDOW_CLOSE_REQUESTED
            KeyDown -> EVENT_KEY_DOWN
            KeyUp -> EVENT_KEY_UP
            TextInput -> EVENT_TEXT_INPUT
            TextEditing -> EVENT_TEXT_EDITING
            MouseMotion -> EVENT_MOUSE_MOTION
            MouseButtonDown -> EVENT_MOUSE_BUTTON_DOWN
            MouseButtonUp -> EVENT_MOUSE_BUTTON_UP
            MouseWheel -> EVENT_MOUSE_WHEEL
            FingerDown -> EVENT_FINGER_DOWN
            FingerUp -> EVENT_FINGER_UP
            FingerMotion -> EVENT_FINGER_MOTION
            FingerCanceled -> EVENT_FINGER_CANCELED
            DropFile -> EVENT_DROP_FILE
            DropText -> EVENT_DROP_TEXT
            DropBegin -> EVENT_DROP_BEGIN
            DropComplete -> EVENT_DROP_COMPLETE
            DropPosition -> EVENT_DROP_POSITION
            User -> EVENT_USER
            Other(n) -> n

    of(code: u32) -> EventKind
        code match
            EVENT_QUIT -> Quit
            EVENT_TERMINATING -> Terminating
            EVENT_LOW_MEMORY -> LowMemory
            EVENT_WILL_ENTER_BACKGROUND -> WillEnterBackground
            EVENT_DID_ENTER_BACKGROUND -> DidEnterBackground
            EVENT_WILL_ENTER_FOREGROUND -> WillEnterForeground
            EVENT_DID_ENTER_FOREGROUND -> DidEnterForeground
            EVENT_LOCALE_CHANGED -> LocaleChanged
            EVENT_SYSTEM_THEME_CHANGED -> SystemThemeChanged
            EVENT_WINDOW_SHOWN -> WindowShown
            EVENT_WINDOW_HIDDEN -> WindowHidden
            EVENT_WINDOW_EXPOSED -> WindowExposed
            EVENT_WINDOW_MOVED -> WindowMoved
            EVENT_WINDOW_RESIZED -> WindowResized
            EVENT_WINDOW_PIXEL_SIZE_CHANGED -> WindowPixelSizeChanged
            EVENT_WINDOW_DISPLAY_CHANGED -> WindowDisplayChanged
            EVENT_WINDOW_DISPLAY_SCALE_CHANGED -> WindowDisplayScaleChanged
            EVENT_WINDOW_MINIMIZED -> WindowMinimized
            EVENT_WINDOW_MAXIMIZED -> WindowMaximized
            EVENT_WINDOW_RESTORED -> WindowRestored
            EVENT_WINDOW_MOUSE_ENTER -> WindowMouseEnter
            EVENT_WINDOW_MOUSE_LEAVE -> WindowMouseLeave
            EVENT_WINDOW_FOCUS_GAINED -> WindowFocusGained
            EVENT_WINDOW_FOCUS_LOST -> WindowFocusLost
            EVENT_WINDOW_CLOSE_REQUESTED -> WindowCloseRequested
            EVENT_KEY_DOWN -> KeyDown
            EVENT_KEY_UP -> KeyUp
            EVENT_TEXT_INPUT -> TextInput
            EVENT_TEXT_EDITING -> TextEditing
            EVENT_MOUSE_MOTION -> MouseMotion
            EVENT_MOUSE_BUTTON_DOWN -> MouseButtonDown
            EVENT_MOUSE_BUTTON_UP -> MouseButtonUp
            EVENT_MOUSE_WHEEL -> MouseWheel
            EVENT_FINGER_DOWN -> FingerDown
            EVENT_FINGER_UP -> FingerUp
            EVENT_FINGER_MOTION -> FingerMotion
            EVENT_FINGER_CANCELED -> FingerCanceled
            EVENT_DROP_FILE -> DropFile
            EVENT_DROP_TEXT -> DropText
            EVENT_DROP_BEGIN -> DropBegin
            EVENT_DROP_COMPLETE -> DropComplete
            EVENT_DROP_POSITION -> DropPosition
            EVENT_USER -> User
            n -> Other(n)
end EventKind

impl Eq for EventKind
    eq(self, other: EventKind) -> bool = self.code() == other.code()

impl Display for EventKind
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Quit -> "quit"
            Terminating -> "terminating"
            LowMemory -> "low memory"
            WillEnterBackground -> "will enter background"
            DidEnterBackground -> "did enter background"
            WillEnterForeground -> "will enter foreground"
            DidEnterForeground -> "did enter foreground"
            LocaleChanged -> "locale changed"
            SystemThemeChanged -> "system theme changed"
            WindowShown -> "window shown"
            WindowHidden -> "window hidden"
            WindowExposed -> "window exposed"
            WindowMoved -> "window moved"
            WindowResized -> "window resized"
            WindowPixelSizeChanged -> "window pixel size changed"
            WindowDisplayChanged -> "window display changed"
            WindowDisplayScaleChanged -> "window display scale changed"
            WindowMinimized -> "window minimized"
            WindowMaximized -> "window maximized"
            WindowRestored -> "window restored"
            WindowMouseEnter -> "mouse entered the window"
            WindowMouseLeave -> "mouse left the window"
            WindowFocusGained -> "window took focus"
            WindowFocusLost -> "window lost focus"
            WindowCloseRequested -> "window close requested"
            KeyDown -> "key down"
            KeyUp -> "key up"
            TextInput -> "text input"
            TextEditing -> "text editing"
            MouseMotion -> "mouse motion"
            MouseButtonDown -> "mouse button down"
            MouseButtonUp -> "mouse button up"
            MouseWheel -> "mouse wheel"
            FingerDown -> "finger down"
            FingerUp -> "finger up"
            FingerMotion -> "finger motion"
            FingerCanceled -> "finger canceled"
            DropFile -> "file dropped"
            DropText -> "text dropped"
            DropBegin -> "drop begin"
            DropComplete -> "drop complete"
            DropPosition -> "drop position"
            User -> "user event"
            Other(_) -> "an event this binding does not name"

        display_str(s, out, fmt)

// Any event. It is SDL's 128-byte union — the three fields every event begins with, then the
// variant — and the accessors below reinterpret it into whichever view the field belongs to.
struct Event
    rec: c.Event

    // What kind of event this is, which is what everything else on it is conditional on.
    kind(self) -> EventKind = EventKind.of(self.rec.kind)

    // When it happened, in the same nanoseconds `ticks_ns` counts.
    timestamp(self) -> u64 = self.rec.timestamp

    // ## Keyboard

    private key(self) -> *c.KeyboardEvent = ptr_cast(&self.rec)

    // The physical key, an SDL scancode — the same number `KeyboardState.held` is indexed by, and
    // the one to use for a game's movement keys, since it does not move with the layout. `c`'s
    // `SCANCODE_*` values name them.
    key_scancode(self) -> i32 = self.key().scancode

    // The *logical* key, an SDL keycode — what the layout says that physical key produces. This is
    // the one a shortcut should compare against, using `c`'s `KEY_*` values.
    key_code(self) -> u32 = self.key().key

    // The modifiers held while the key went down, a mask of `c`'s `KMOD_*` values. Test a
    // side-agnostic modifier with the combined alias: `(e.key_mod() & KMOD_SHIFT) != 0`.
    key_mod(self) -> u16 = self.key().mod

    // Whether this is the operating system repeating a held key rather than a fresh press.
    key_repeat(self) -> bool = self.key().repeat

    // ## Mouse

    private motion(self) -> *c.MouseMotionEvent = ptr_cast(&self.rec)

    private button(self) -> *c.MouseButtonEvent = ptr_cast(&self.rec)

    private wheel(self) -> *c.MouseWheelEvent = ptr_cast(&self.rec)

    // The cursor position a motion event reports, in window coordinates. A button event carries the
    // position at the same offsets, so this reads either.
    mouse_x(self) -> f32 = self.motion().x
    mouse_y(self) -> f32 = self.motion().y

    // Which button.
    mouse_button(self) -> MouseButton = MouseButton.of(self.button().button)

    // How many clicks in the run this one closes: 1 for a single, 2 for a double.
    mouse_clicks(self) -> u8 = self.button().clicks

    // Scroll amounts. Positive `y` is away from the user.
    wheel_x(self) -> f32 = self.wheel().x
    wheel_y(self) -> f32 = self.wheel().y

    // Which mouse, and the reason to care is that one of them is not a mouse. A motion, button or
    // wheel event synthesized from a finger reports `TOUCH_MOUSEID` here, so a program reading
    // the `Finger*` events drops these and handles each tap once.
    mouse_which(self) -> u32 = self.motion().which

    // ## Touch

    private finger(self) -> *c.TouchFingerEvent = ptr_cast(&self.rec)

    // **Where the finger is, normalized to `0..1` across the window — not pixels.** This is the one
    // place touch and mouse disagree about units, and the disagreement is silent: a `0.5` used as a
    // coordinate lands in the top-left corner rather than the middle, and a layout written against
    // it is wrong everywhere except a window one pixel wide. `finger_pos_in` does the multiplication.
    finger_x(self) -> f32 = self.finger().x
    finger_y(self) -> f32 = self.finger().y

    // The same position in window coordinates, which is what every other event already carries and
    // what a hit test wants. Pass the window's own size — `Window.size` for a program drawing in
    // logical coordinates, `Renderer.output_size` for one drawing in pixels.
    finger_pos_in(self, width: f32, height: f32) -> (f32, f32) =
        (self.finger().x * width, self.finger().y * height)

    // How far the finger moved since the last motion event, normalized the same way and signed, so
    // in `-1..1`.
    finger_dx(self) -> f32 = self.finger().dx
    finger_dy(self) -> f32 = self.finger().dy

    // How hard, in `0..1`. A device that cannot measure it reports `1.0` while the finger is down,
    // so this is a fine thing to draw with and a poor thing to branch on.
    finger_pressure(self) -> f32 = self.finger().pressure

    // Which finger, and which device it is on. The finger id is what identifies one finger across
    // its whole gesture — it is stable from `FingerDown` to the `FingerUp` or `FingerCanceled` that
    // ends it, and is how two fingers are told apart for a pinch. It is *not* an index: nothing says
    // the first finger down has the lower number, and neither is reused predictably.
    //
    // A `touch_id` of `MOUSE_TOUCHID` means this was really the mouse.
    finger_id(self) -> u64 = self.finger().finger_id
    touch_id(self) -> u64 = self.finger().touch_id

    // The window under the finger. **This is what `window_id` cannot answer for a touch event** —
    // SDL puts this field at the end of the touch struct rather than at the front where every other
    // variant has it, so the general accessor reads the touch id's low half instead.
    finger_window_id(self) -> u32 = self.finger().window_id

    // ## Text input

    private text_event(self) -> *c.TextEvent = ptr_cast(&self.rec)

    // The typed text of a `TextInput`, UTF-8. SDL owns the string and frees it once the event is
    // handled, so it is copied out here.
    text(self) -> string
        val p = self.text_event().text

        if p == null then "" else from_cstring(p).unwrap_or("")
    end text

    private editing(self) -> *c.TextEditingEvent = ptr_cast(&self.rec)

    // **The part of a `TextEditing` composition the input method has selected**, as an offset and a
    // length into the `text` above. This is what draws the underline a CJK or accent-composing
    // keyboard shows while a word is being formed, and without it a field can show the composing
    // text but not which of it is live.
    //
    // Both are **`-1` when the platform does not say**, which is an ordinary answer rather than a
    // failure — several platforms report the composition and not the range within it. A field that
    // gets `-1` underlines the whole composition.
    //
    // They read the two words `SDL_TextEditingEvent` has past the end of `SDL_TextInputEvent`, so
    // they are meaningful for `TextEditing` alone. `text` is in the shared prefix and reads either.
    composition_start(self) -> i32 = self.editing().start
    composition_length(self) -> i32 = self.editing().length

    // ## Drag and drop

    private drop_event(self) -> *c.DropEvent = ptr_cast(&self.rec)

    // The dropped path or text. Empty for the payload-less `DropBegin` and `DropComplete`. SDL frees
    // the string after the event is handled, so this copies.
    drop_data(self) -> string
        val p = self.drop_event().data

        if p == null then "" else from_cstring(p).unwrap_or("")
    end drop_data

    // The application the drag started in, where the platform says.
    drop_source(self) -> string
        val p = self.drop_event().source

        if p == null then "" else from_cstring(p).unwrap_or("")
    end drop_source

    // Where in the window the drop landed. Not populated on `DropBegin`.
    drop_x(self) -> f32 = self.drop_event().x
    drop_y(self) -> f32 = self.drop_event().y

    // ## Windows

    private window(self) -> *c.WindowEvent = ptr_cast(&self.rec)

    // Which window the event belongs to, matching `Window.id`. Nearly every windowed variant carries
    // it at the same offset, so this reads a key, mouse, text, drop or window event alike.
    //
    // **The touch events are the exception, and this answers nonsense for one.** `SDL_TouchFingerEvent`
    // puts its window id at the *end* of the struct rather than the front, and what sits at this
    // offset instead is the low half of the 64-bit touch id. Use `finger_window_id` for those; there
    // is no way for one accessor to serve both, because the union is what it is.
    window_id(self) -> u32 = self.window().window_id

    // A window event's two payload words. For `WindowResized` and `WindowPixelSizeChanged` they are
    // the new width and height.
    window_data1(self) -> i32 = self.window().data1
    window_data2(self) -> i32 = self.window().data2

    // ## User events

    private user(self) -> *c.UserEvent = ptr_cast(&self.rec)

    // The `code` a program put on an event it pushed itself.
    user_code(self) -> i32 = self.user().code
end Event

// An empty event, which is what the polling calls are handed to fill.
empty_event() -> Event = Event(c.Event(0, 0, 0, [0; 112]))

// The next pending event, or nothing when the queue is empty. This is the loop a program runs at
// the top of every frame.
poll_event() -> Option[Event]
    var e = c.Event(0, 0, 0, [0; 112])

    if c.poll_event(&e) then Some(Event(e)) else None
end poll_event

// Block until an event arrives. For a program that draws only when something changes — an editor
// rather than a game — this is what keeps it off the processor between keystrokes.
wait_event() -> Option[Event]
    var e = c.Event(0, 0, 0, [0; 112])

    if c.wait_event(&e) then Some(Event(e)) else None
end wait_event

// Block for at most this many milliseconds. Nothing means the wait timed out.
wait_event_timeout(ms: i32) -> Option[Event]
    var e = c.Event(0, 0, 0, [0; 112])

    if c.wait_event_timeout(&e, ms) then Some(Event(e)) else None
end wait_event_timeout

// Put an event on the queue.
push_event(e: Event) -> bool
    var v = e.rec

    c.push_event(&v)
end push_event

// A user event carrying a code, which is the usual way one part of a program wakes another.
//
// **It is built as a `c.UserEvent` and reinterpreted, rather than filled through the views above**,
// because those take `self` by value: the pointer they answer points into the method's own copy, so
// reading through it is fine and writing through it would write into storage that is about to go.
// That is why they are private, and why anything that *builds* an event constructs the variant.
user_event(code: i32) -> Event
    var u = c.UserEvent(EVENT_USER, 0, 0, 0, code, null, null, [0; 88])
    val p: *c.Event = ptr_cast(&u)

    Event(p[0])
end user_event

// Gather pending input from the platform without taking anything off the queue. `poll_event` does
// this itself, so it is only needed by a program that reads `KeyboardState.held` or `mouse_state`
// without polling.
pump_events() = c.pump_events()

// Discard every queued event whose kind falls in the range, inclusive.
flush_events(min: EventKind, max: EventKind) = c.flush_events(min.code(), max.code())

// ## Event watches
//
// **SDL calls a C function pointer for every event as it is pumped, and a `*extern` cannot
// capture** — so what a closure API needs is a single static trampoline registered with SDL and the
// closures kept in module storage where the trampoline can find them again. That is the same shape
// the Scala binding to this library uses, for the same reason.
//
// A watch fires on the thread that pumps events, which is the main thread, so nothing here crosses
// a thread boundary.

struct Watch
    id: int
    f: &Fn(Event) -> unit

private var watches: Buf[Watch] = buf()
private var next_watch_id: int = 0
private var watch_registered: bool = false

// The one function pointer SDL ever holds. Answering `true` leaves the event on the queue for the
// ordinary `poll_event` loop to see as well, which is what a watch is for — observing, not
// filtering.
watch_trampoline(ud: *u8, ev: *c.Event) -> bool
    val e = Event(ev[0])

    for i in 0..<watches.len() do watches[i].f(e)
    true
end watch_trampoline

// Call `f` for every event as it is pumped, *before* it reaches the queue. Answers an id for
// `remove_event_watch`.
//
// This is how a program reacts to a resize while it is still inside the platform's modal drag loop,
// which is the case `poll_event` cannot reach: on macOS and Windows a live window drag does not
// return to the application's own loop until the mouse comes up.
add_event_watch(f: &Fn(Event) -> unit) -> int
    if !watch_registered
        c.add_event_watch(&watch_trampoline, null)
        watch_registered = true

    val id = next_watch_id

    next_watch_id += 1
    watches.push(Watch(id, f))
    id
end add_event_watch

// Stop calling the watch with this id. The trampoline is unregistered from SDL once the last one
// goes, so a program that adds none pays nothing.
remove_event_watch(id: int)
    var i: usize = 0

    while i < watches.len()
        if watches[i].id == id
            watches.remove(i)
            break

        i += 1

    if watches.len() == 0 && watch_registered
        c.remove_event_watch(&watch_trampoline, null)
        watch_registered = false
end remove_event_watch
