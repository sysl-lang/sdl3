module sh.sysl.sdl3

@include("SDL3/SDL.h")

// SDL_GPU's numbers, read from `SDL_gpu.h` by the C compiler rather than transcribed — the same
// arrangement as `constants.sysl`, and for the same reason: a value wrong on this side is refused by
// clang, not found at run time as a pipeline that quietly draws nothing.
//
// Every enumeration is an `i32` and every flag set a `u32`, which is C's own width for each. The
// names drop `SDL_`, so `SDL_GPU_LOADOP_CLEAR` is `GPU_LOADOP_CLEAR`.

// ### Shader formats (a flag set), shader stages
c const
    GPU_SHADERFORMAT_PRIVATE:  u32 = "SDL_GPU_SHADERFORMAT_PRIVATE"
    GPU_SHADERFORMAT_SPIRV:    u32 = "SDL_GPU_SHADERFORMAT_SPIRV"
    GPU_SHADERFORMAT_DXBC:     u32 = "SDL_GPU_SHADERFORMAT_DXBC"
    GPU_SHADERFORMAT_DXIL:     u32 = "SDL_GPU_SHADERFORMAT_DXIL"
    GPU_SHADERFORMAT_MSL:      u32 = "SDL_GPU_SHADERFORMAT_MSL"
    GPU_SHADERFORMAT_METALLIB: u32 = "SDL_GPU_SHADERFORMAT_METALLIB"
    GPU_SHADERSTAGE_VERTEX:    i32 = "SDL_GPU_SHADERSTAGE_VERTEX"
    GPU_SHADERSTAGE_FRAGMENT:  i32 = "SDL_GPU_SHADERSTAGE_FRAGMENT"

// ### Usage flags
c const
    GPU_TEXTUREUSAGE_SAMPLER:                u32 = "SDL_GPU_TEXTUREUSAGE_SAMPLER"
    GPU_TEXTUREUSAGE_COLOR_TARGET:           u32 = "SDL_GPU_TEXTUREUSAGE_COLOR_TARGET"
    GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET:   u32 = "SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET"
    GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ:  u32 = "SDL_GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ"
    GPU_BUFFERUSAGE_VERTEX:                  u32 = "SDL_GPU_BUFFERUSAGE_VERTEX"
    GPU_BUFFERUSAGE_INDEX:                   u32 = "SDL_GPU_BUFFERUSAGE_INDEX"
    GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ:   u32 = "SDL_GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ"
    GPU_TRANSFERBUFFERUSAGE_UPLOAD:          i32 = "SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD"
    GPU_TRANSFERBUFFERUSAGE_DOWNLOAD:        i32 = "SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD"
    GPU_COLORCOMPONENT_R:                    u32 = "SDL_GPU_COLORCOMPONENT_R"
    GPU_COLORCOMPONENT_G:                    u32 = "SDL_GPU_COLORCOMPONENT_G"
    GPU_COLORCOMPONENT_B:                    u32 = "SDL_GPU_COLORCOMPONENT_B"
    GPU_COLORCOMPONENT_A:                    u32 = "SDL_GPU_COLORCOMPONENT_A"

// ### Textures
c const
    GPU_TEXTURETYPE_2D:                    i32 = "SDL_GPU_TEXTURETYPE_2D"
    GPU_TEXTURETYPE_2D_ARRAY:              i32 = "SDL_GPU_TEXTURETYPE_2D_ARRAY"
    GPU_TEXTURETYPE_3D:                    i32 = "SDL_GPU_TEXTURETYPE_3D"
    GPU_TEXTURETYPE_CUBE:                  i32 = "SDL_GPU_TEXTURETYPE_CUBE"
    GPU_SAMPLECOUNT_1:                     i32 = "SDL_GPU_SAMPLECOUNT_1"
    GPU_SAMPLECOUNT_2:                     i32 = "SDL_GPU_SAMPLECOUNT_2"
    GPU_SAMPLECOUNT_4:                     i32 = "SDL_GPU_SAMPLECOUNT_4"
    GPU_SAMPLECOUNT_8:                     i32 = "SDL_GPU_SAMPLECOUNT_8"
    GPU_TEXTUREFORMAT_INVALID:             i32 = "SDL_GPU_TEXTUREFORMAT_INVALID"
    GPU_TEXTUREFORMAT_R8_UNORM:            i32 = "SDL_GPU_TEXTUREFORMAT_R8_UNORM"
    GPU_TEXTUREFORMAT_R8G8_UNORM:          i32 = "SDL_GPU_TEXTUREFORMAT_R8G8_UNORM"
    GPU_TEXTUREFORMAT_R8G8B8A8_UNORM:      i32 = "SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM"
    GPU_TEXTUREFORMAT_B8G8R8A8_UNORM:      i32 = "SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM"
    GPU_TEXTUREFORMAT_R8G8B8A8_UNORM_SRGB: i32 = "SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM_SRGB"
    GPU_TEXTUREFORMAT_B8G8R8A8_UNORM_SRGB: i32 = "SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM_SRGB"
    GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT:  i32 = "SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT"
    GPU_TEXTUREFORMAT_R32G32B32A32_FLOAT:  i32 = "SDL_GPU_TEXTUREFORMAT_R32G32B32A32_FLOAT"
    GPU_TEXTUREFORMAT_D16_UNORM:           i32 = "SDL_GPU_TEXTUREFORMAT_D16_UNORM"
    GPU_TEXTUREFORMAT_D24_UNORM:           i32 = "SDL_GPU_TEXTUREFORMAT_D24_UNORM"
    GPU_TEXTUREFORMAT_D32_FLOAT:           i32 = "SDL_GPU_TEXTUREFORMAT_D32_FLOAT"
    GPU_TEXTUREFORMAT_D24_UNORM_S8_UINT:   i32 = "SDL_GPU_TEXTUREFORMAT_D24_UNORM_S8_UINT"
    GPU_TEXTUREFORMAT_D32_FLOAT_S8_UINT:   i32 = "SDL_GPU_TEXTUREFORMAT_D32_FLOAT_S8_UINT"

// ### Pipeline state
c const
    GPU_PRIMITIVETYPE_TRIANGLELIST:       i32 = "SDL_GPU_PRIMITIVETYPE_TRIANGLELIST"
    GPU_PRIMITIVETYPE_TRIANGLESTRIP:      i32 = "SDL_GPU_PRIMITIVETYPE_TRIANGLESTRIP"
    GPU_PRIMITIVETYPE_LINELIST:           i32 = "SDL_GPU_PRIMITIVETYPE_LINELIST"
    GPU_PRIMITIVETYPE_LINESTRIP:          i32 = "SDL_GPU_PRIMITIVETYPE_LINESTRIP"
    GPU_PRIMITIVETYPE_POINTLIST:          i32 = "SDL_GPU_PRIMITIVETYPE_POINTLIST"
    GPU_VERTEXELEMENTFORMAT_FLOAT:        i32 = "SDL_GPU_VERTEXELEMENTFORMAT_FLOAT"
    GPU_VERTEXELEMENTFORMAT_FLOAT2:       i32 = "SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2"
    GPU_VERTEXELEMENTFORMAT_FLOAT3:       i32 = "SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3"
    GPU_VERTEXELEMENTFORMAT_FLOAT4:       i32 = "SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4"
    GPU_VERTEXELEMENTFORMAT_UINT:         i32 = "SDL_GPU_VERTEXELEMENTFORMAT_UINT"
    GPU_VERTEXELEMENTFORMAT_UBYTE4_NORM:  i32 = "SDL_GPU_VERTEXELEMENTFORMAT_UBYTE4_NORM"
    GPU_VERTEXINPUTRATE_VERTEX:           i32 = "SDL_GPU_VERTEXINPUTRATE_VERTEX"
    GPU_VERTEXINPUTRATE_INSTANCE:         i32 = "SDL_GPU_VERTEXINPUTRATE_INSTANCE"
    GPU_FILLMODE_FILL:                    i32 = "SDL_GPU_FILLMODE_FILL"
    GPU_FILLMODE_LINE:                    i32 = "SDL_GPU_FILLMODE_LINE"
    GPU_CULLMODE_NONE:                    i32 = "SDL_GPU_CULLMODE_NONE"
    GPU_CULLMODE_FRONT:                   i32 = "SDL_GPU_CULLMODE_FRONT"
    GPU_CULLMODE_BACK:                    i32 = "SDL_GPU_CULLMODE_BACK"
    GPU_FRONTFACE_COUNTER_CLOCKWISE:      i32 = "SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE"
    GPU_FRONTFACE_CLOCKWISE:              i32 = "SDL_GPU_FRONTFACE_CLOCKWISE"
    GPU_COMPAREOP_INVALID:                i32 = "SDL_GPU_COMPAREOP_INVALID"
    GPU_COMPAREOP_NEVER:                  i32 = "SDL_GPU_COMPAREOP_NEVER"
    GPU_COMPAREOP_LESS:                   i32 = "SDL_GPU_COMPAREOP_LESS"
    GPU_COMPAREOP_EQUAL:                  i32 = "SDL_GPU_COMPAREOP_EQUAL"
    GPU_COMPAREOP_LESS_OR_EQUAL:          i32 = "SDL_GPU_COMPAREOP_LESS_OR_EQUAL"
    GPU_COMPAREOP_GREATER:                i32 = "SDL_GPU_COMPAREOP_GREATER"
    GPU_COMPAREOP_NOT_EQUAL:              i32 = "SDL_GPU_COMPAREOP_NOT_EQUAL"
    GPU_COMPAREOP_GREATER_OR_EQUAL:       i32 = "SDL_GPU_COMPAREOP_GREATER_OR_EQUAL"
    GPU_COMPAREOP_ALWAYS:                 i32 = "SDL_GPU_COMPAREOP_ALWAYS"
    GPU_STENCILOP_KEEP:                   i32 = "SDL_GPU_STENCILOP_KEEP"
    GPU_BLENDOP_ADD:                      i32 = "SDL_GPU_BLENDOP_ADD"
    GPU_BLENDFACTOR_ZERO:                 i32 = "SDL_GPU_BLENDFACTOR_ZERO"
    GPU_BLENDFACTOR_ONE:                  i32 = "SDL_GPU_BLENDFACTOR_ONE"
    GPU_BLENDFACTOR_SRC_ALPHA:            i32 = "SDL_GPU_BLENDFACTOR_SRC_ALPHA"
    GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA:  i32 = "SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA"

// ### Passes, samplers, the swapchain
c const
    GPU_LOADOP_LOAD:                      i32 = "SDL_GPU_LOADOP_LOAD"
    GPU_LOADOP_CLEAR:                     i32 = "SDL_GPU_LOADOP_CLEAR"
    GPU_LOADOP_DONT_CARE:                 i32 = "SDL_GPU_LOADOP_DONT_CARE"
    GPU_STOREOP_STORE:                    i32 = "SDL_GPU_STOREOP_STORE"
    GPU_STOREOP_DONT_CARE:                i32 = "SDL_GPU_STOREOP_DONT_CARE"
    GPU_STOREOP_RESOLVE:                  i32 = "SDL_GPU_STOREOP_RESOLVE"
    GPU_STOREOP_RESOLVE_AND_STORE:        i32 = "SDL_GPU_STOREOP_RESOLVE_AND_STORE"
    GPU_INDEXELEMENTSIZE_16BIT:           i32 = "SDL_GPU_INDEXELEMENTSIZE_16BIT"
    GPU_INDEXELEMENTSIZE_32BIT:           i32 = "SDL_GPU_INDEXELEMENTSIZE_32BIT"
    GPU_FILTER_NEAREST:                   i32 = "SDL_GPU_FILTER_NEAREST"
    GPU_FILTER_LINEAR:                    i32 = "SDL_GPU_FILTER_LINEAR"
    GPU_SAMPLERMIPMAPMODE_NEAREST:        i32 = "SDL_GPU_SAMPLERMIPMAPMODE_NEAREST"
    GPU_SAMPLERMIPMAPMODE_LINEAR:         i32 = "SDL_GPU_SAMPLERMIPMAPMODE_LINEAR"
    GPU_SAMPLERADDRESSMODE_REPEAT:        i32 = "SDL_GPU_SAMPLERADDRESSMODE_REPEAT"
    GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT: i32 = "SDL_GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT"
    GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE: i32 = "SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE"
    GPU_PRESENTMODE_VSYNC:                i32 = "SDL_GPU_PRESENTMODE_VSYNC"
    GPU_PRESENTMODE_IMMEDIATE:            i32 = "SDL_GPU_PRESENTMODE_IMMEDIATE"
    GPU_PRESENTMODE_MAILBOX:              i32 = "SDL_GPU_PRESENTMODE_MAILBOX"
    GPU_SWAPCHAINCOMPOSITION_SDR:         i32 = "SDL_GPU_SWAPCHAINCOMPOSITION_SDR"
    GPU_SWAPCHAINCOMPOSITION_SDR_LINEAR:  i32 = "SDL_GPU_SWAPCHAINCOMPOSITION_SDR_LINEAR"
