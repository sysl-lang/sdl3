// The two Android calls `system.sysl` is built on, where SDL has them.

module sh.sysl.sdl3

import sh.sysl.sdl3.c

private[sdl3] posted(command: u32, param: i32) -> bool = c.send_android_message(command, param)

private[sdl3] asked(permission: *u8, cb: *extern(*u8, *u8, bool) -> unit, userdata: *u8) -> bool =
    c.request_android_permission(permission, cb, userdata)
