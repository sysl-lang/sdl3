// ---- keycodes (SDL_Keycode) ----
//
// The *logical* keys, which follow the layout. A printable key's keycode is its Unicode code point,
// so `'a'` is 97 and there is nothing to transcribe; what is listed here is the rest, whose values
// are the scancode with SDL's `SDLK_SCANCODE_MASK` (bit 30) set.

const KEY_RETURN: u32 = 0x0000000d
const KEY_ESCAPE: u32 = 0x0000001b
const KEY_BACKSPACE: u32 = 0x00000008
const KEY_TAB: u32 = 0x00000009
const KEY_SPACE: u32 = 0x00000020
const KEY_DELETE: u32 = 0x0000007f

const KEY_RIGHT: u32 = 0x4000004f
const KEY_LEFT: u32 = 0x40000050
const KEY_DOWN: u32 = 0x40000051
const KEY_UP: u32 = 0x40000052
const KEY_HOME: u32 = 0x4000004a
const KEY_END: u32 = 0x4000004d
const KEY_PAGEUP: u32 = 0x4000004b
const KEY_PAGEDOWN: u32 = 0x4000004e
const KEY_INSERT: u32 = 0x40000049

const KEY_F1: u32 = 0x4000003a
const KEY_F2: u32 = 0x4000003b
const KEY_F3: u32 = 0x4000003c
const KEY_F4: u32 = 0x4000003d
const KEY_F5: u32 = 0x4000003e
const KEY_F6: u32 = 0x4000003f
const KEY_F7: u32 = 0x40000040
const KEY_F8: u32 = 0x40000041
const KEY_F9: u32 = 0x40000042
const KEY_F10: u32 = 0x40000043
const KEY_F11: u32 = 0x40000044
const KEY_F12: u32 = 0x40000045
