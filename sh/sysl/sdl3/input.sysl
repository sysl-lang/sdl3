module sh.sysl.sdl3
@link("SDL3")

import sysl.text.from_cstring

// Keyboard, mouse and cursor — the polled half of input, beside the events.
//
// **Polling and events answer different questions.** An event says "this key went down at this
// moment", which is what a text field or a shortcut wants; the state below says "this key is held
// right now", which is what a movement loop wants and what no sequence of events reconstructs
// without keeping its own table.

extern "SDL_GetKeyboardState" sdl_get_keyboard_state(numkeys: *i32) -> *bool
extern "SDL_GetModState" sdl_get_mod_state() -> u16
extern "SDL_SetModState" sdl_set_mod_state(mod: u16)
extern "SDL_GetMouseState" sdl_get_mouse_state(x: *f32, y: *f32) -> u32
extern "SDL_GetGlobalMouseState" sdl_get_global_mouse_state(x: *f32, y: *f32) -> u32
extern "SDL_WarpMouseInWindow" sdl_warp_mouse_in_window(window: *u8, x: f32, y: f32)
extern "SDL_GetScancodeName" sdl_get_scancode_name(scancode: i32) -> *u8
extern "SDL_GetKeyName" sdl_get_key_name(key: u32) -> *u8
extern "SDL_GetKeyFromScancode" sdl_get_key_from_scancode(scancode: i32, mod: u16, key_event: bool) -> u32

extern "SDL_CreateSystemCursor" sdl_create_system_cursor(id: i32) -> *u8
extern "SDL_SetCursor" sdl_set_cursor(cursor: *u8) -> bool
extern "SDL_GetCursor" sdl_get_cursor() -> *u8
extern "SDL_GetDefaultCursor" sdl_get_default_cursor() -> *u8
extern "SDL_DestroyCursor" sdl_destroy_cursor(cursor: *u8)
extern "SDL_ShowCursor" sdl_show_cursor() -> bool
extern "SDL_HideCursor" sdl_hide_cursor() -> bool
extern "SDL_CursorVisible" sdl_cursor_visible() -> bool

// ---- keyboard ----

// A snapshot of which physical keys are held, indexed by scancode.
//
// **SDL owns the array and keeps it up to date**, so this is a view rather than a copy and reading
// it later reads the later state. That is why it holds a length as well: an index past the end
// would be reading whatever follows SDL's table.
struct KeyboardState
    ptr: *bool
    count: i32

    // Whether this physical key is down. A scancode outside the table answers `false` rather than
    // reading past the end.
    held(self, scancode: i32) -> bool =
        if scancode < 0 || scancode >= self.count then false else self.ptr[usize(scancode)]

    // How many scancodes the platform reports.
    len(self) -> i32 = self.count
end KeyboardState

// The keys held right now. Cheap — SDL hands back a pointer to its own table — so a frame loop may
// ask each time round rather than caching.
keyboard_state() -> KeyboardState
    var n: i32 = 0
    val p = sdl_get_keyboard_state(&n)

    KeyboardState(p, n)
end keyboard_state

// The modifier keys held right now, a mask of the `KMOD_*` values. This is what a mouse or wheel
// event has to use, since only a keyboard event carries a modifier field of its own.
mod_state() -> u16 = sdl_get_mod_state()

// Tell SDL which modifiers are held. For a program synthesising input; ordinary code reads.
set_mod_state(m: u16) = sdl_set_mod_state(m)

// The platform's name for a physical key — "Left Shift", "F1" — which is what a key-binding screen
// shows. Empty for a scancode the platform has no name for.
scancode_name(scancode: i32) -> string = from_cstring(sdl_get_scancode_name(scancode)).unwrap_or("")

// The name of a *logical* key, which follows the layout: the same scancode is "Q" on QWERTY and "A"
// on AZERTY.
key_name(key: u32) -> string = from_cstring(sdl_get_key_name(key)).unwrap_or("")

// What the current layout makes of a physical key.
key_from_scancode(scancode: i32) -> u32 = sdl_get_key_from_scancode(scancode, KMOD_NONE, false)

// ---- mouse ----

// Where the pointer is and which buttons are down.
struct MouseState
    buttons: u32
    x: f32
    y: f32

    left(self) -> bool = (self.buttons & BUTTON_LMASK) != 0
    middle(self) -> bool = (self.buttons & BUTTON_MMASK) != 0
    right(self) -> bool = (self.buttons & BUTTON_RMASK) != 0
end MouseState

// The pointer's position in the focused window's coordinates, and its buttons.
mouse_state() -> MouseState
    var x: f32 = 0.0
    var y: f32 = 0.0
    val b = sdl_get_mouse_state(&x, &y)

    MouseState(b, x, y)
end mouse_state

// The same in desktop coordinates, which is what a program dragging something outside its own
// window needs.
global_mouse_state() -> MouseState
    var x: f32 = 0.0
    var y: f32 = 0.0
    val b = sdl_get_global_mouse_state(&x, &y)

    MouseState(b, x, y)
end global_mouse_state

// Move the pointer to a point in a window.
warp_mouse(window: Window, x: f32, y: f32) = sdl_warp_mouse_in_window(window.handle, x, y)

// ---- cursors ----
//
// The pointer's shape is process-wide rather than per-window: setting one changes it everywhere
// until the next set. A program that wants a resize arrow over a divider and an I-beam over text
// builds the shapes it needs once — they are cheap, and SDL caches the platform cursor behind each
// — keeps the handles, and sets one as the pointer moves.

// A mouse pointer shape.
struct Cursor
    handle: *u8

    // Make this the active shape, everywhere. `true` on success.
    set(self) -> bool = sdl_set_cursor(self.handle)

    // Free it. **Only for a cursor this program made** — never for what `default_cursor` or
    // `current_cursor` answers, which SDL owns.
    destroy(self) = sdl_destroy_cursor(self.handle)
end Cursor

// One of the built-in shapes — `id` is a `SYSTEM_CURSOR_*` value. Nothing if the platform cannot
// make it. The result belongs to the caller and is freed with `Cursor.destroy`.
create_system_cursor(id: i32) -> Option[Cursor]
    val c = sdl_create_system_cursor(id)

    if c == null then None else Some(Cursor(c))
end create_system_cursor

// The shape currently set, or nothing when the default is in effect and none was set. **Does not
// transfer ownership** — never destroy what this answers.
current_cursor() -> Option[Cursor]
    val c = sdl_get_cursor()

    if c == null then None else Some(Cursor(c))
end current_cursor

// The platform's own default, the arrow. SDL owns it; do not destroy it.
default_cursor() -> Option[Cursor]
    val c = sdl_get_default_cursor()

    if c == null then None else Some(Cursor(c))
end default_cursor

// Show the pointer — it is visible to begin with. Visibility is independent of which shape is set.
show_cursor() -> bool = sdl_show_cursor()

// Hide it, for a video player's idle chrome or a game that draws its own.
hide_cursor() -> bool = sdl_hide_cursor()

cursor_visible() -> bool = sdl_cursor_visible()

// ---- system cursor shapes (SDL_SystemCursor) ----
//
// The two families of resize cursor look the same on most platforms: `NWSE`, `NESW`, `EW` and `NS`
// are the diagonal and axis double-arrows, while the per-edge `N`, `NE` and so on let a platform
// draw a directional single arrow where it has one.

const SYSTEM_CURSOR_DEFAULT: i32 = 0
const SYSTEM_CURSOR_TEXT: i32 = 1
const SYSTEM_CURSOR_WAIT: i32 = 2
const SYSTEM_CURSOR_CROSSHAIR: i32 = 3
const SYSTEM_CURSOR_PROGRESS: i32 = 4
const SYSTEM_CURSOR_NWSE_RESIZE: i32 = 5
const SYSTEM_CURSOR_NESW_RESIZE: i32 = 6
const SYSTEM_CURSOR_EW_RESIZE: i32 = 7
const SYSTEM_CURSOR_NS_RESIZE: i32 = 8
const SYSTEM_CURSOR_MOVE: i32 = 9
const SYSTEM_CURSOR_NOT_ALLOWED: i32 = 10
const SYSTEM_CURSOR_POINTER: i32 = 11
const SYSTEM_CURSOR_NW_RESIZE: i32 = 12
const SYSTEM_CURSOR_N_RESIZE: i32 = 13
const SYSTEM_CURSOR_NE_RESIZE: i32 = 14
const SYSTEM_CURSOR_E_RESIZE: i32 = 15
const SYSTEM_CURSOR_SE_RESIZE: i32 = 16
const SYSTEM_CURSOR_S_RESIZE: i32 = 17
const SYSTEM_CURSOR_SW_RESIZE: i32 = 18
const SYSTEM_CURSOR_W_RESIZE: i32 = 19

// ---- key modifiers (SDL_Keymod) ----
//
// The mask a keyboard event carries and `mod_state` answers. The combined aliases match either
// side, which is what a shortcut should test.

const KMOD_NONE: u16 = 0x0000
const KMOD_LSHIFT: u16 = 0x0001
const KMOD_RSHIFT: u16 = 0x0002
const KMOD_LEVEL5: u16 = 0x0004
const KMOD_LCTRL: u16 = 0x0040
const KMOD_RCTRL: u16 = 0x0080
const KMOD_LALT: u16 = 0x0100
const KMOD_RALT: u16 = 0x0200
const KMOD_LGUI: u16 = 0x0400
const KMOD_RGUI: u16 = 0x0800
const KMOD_NUM: u16 = 0x1000
const KMOD_CAPS: u16 = 0x2000
const KMOD_MODE: u16 = 0x4000
const KMOD_SCROLL: u16 = 0x8000

const KMOD_SHIFT: u16 = 0x0003
const KMOD_CTRL: u16 = 0x00c0
const KMOD_ALT: u16 = 0x0300
const KMOD_GUI: u16 = 0x0c00

// ---- scancodes ----
//
// The physical keys, which are USB HID usage ids and do not move with the keyboard layout. This is
// what `KeyboardState.held` is indexed by and what a game's movement keys should be written in
// terms of; a *shortcut* wants the logical keycode instead, since the user pressing "the key marked
// Q" is what they mean.

const SCANCODE_A: i32 = 4
const SCANCODE_B: i32 = 5
const SCANCODE_C: i32 = 6
const SCANCODE_D: i32 = 7
const SCANCODE_E: i32 = 8
const SCANCODE_F: i32 = 9
