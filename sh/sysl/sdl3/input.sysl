module sh.sysl.sdl3

import sh.sysl.sdl3.c
import sysl.text.from_cstring

// Keyboard, mouse and cursor — the polled half of input, beside the events.
//
// **Polling and events answer different questions.** An event says "this key went down at this
// moment", which is what a text field or a shortcut wants; the state below says "this key is held
// right now", which is what a movement loop wants and what no sequence of events reconstructs
// without keeping its own table.
//
// **The scancodes, keycodes and modifier masks stay numbers rather than becoming variants**,
// because they are an index space rather than a small closed set — `KeyboardState` is literally an
// array indexed by scancode, and SDL has two hundred and forty of them. What this layer does for
// them is carry them, so a program names one without importing anything but this module:
//
//     import sh.sysl.sdl3.*
//
//     if keyboard_state().held(SCANCODE_W) then …

// ## Keyboard

// A snapshot of which physical keys are held, indexed by scancode.
//
// **SDL owns the array and keeps it up to date**, so this is a view rather than a copy and reading
// it later reads the later state. That is why it holds a length as well: an index past the end
// would be reading whatever follows SDL's table.
struct KeyboardState
    ptr: *bool
    count: i32

    // Whether this physical key is down. A scancode outside the table answers `false` rather than
    // reading past the end.
    held(self, scancode: i32) -> bool =
        if scancode < 0 || scancode >= self.count then false else self.ptr[usize(scancode)]

    // How many scancodes the platform reports.
    len(self) -> i32 = self.count
end KeyboardState

// The keys held right now. Cheap — SDL hands back a pointer to its own table — so a frame loop may
// ask each time round rather than caching.
keyboard_state() -> KeyboardState
    var n: i32 = 0
    val p = c.get_keyboard_state(&n)

    KeyboardState(p, n)
end keyboard_state

// The modifier keys held right now, a mask of `c`'s `KMOD_*` values. This is what a mouse or wheel
// event has to use, since only a keyboard event carries a modifier field of its own.
mod_state() -> u16 = c.get_mod_state()

// Tell SDL which modifiers are held. For a program synthesising input; ordinary code reads.
set_mod_state(m: u16) = c.set_mod_state(m)

// The platform's name for a physical key — "Left Shift", "F1" — which is what a key-binding screen
// shows. Empty for a scancode the platform has no name for.
scancode_name(scancode: i32) -> string =
    from_cstring(c.get_scancode_name(scancode)).unwrap_or("")

// The name of a *logical* key, which follows the layout: the same scancode is "Q" on QWERTY and "A"
// on AZERTY.
key_name(key: u32) -> string = from_cstring(c.get_key_name(key)).unwrap_or("")

// What the current layout makes of a physical key.
key_from_scancode(scancode: i32) -> u32 = c.get_key_from_scancode(scancode, KMOD_NONE, false)

// ## Mouse

// Which button an event is about.
enum MouseButton
    Left
    Middle
    Right

    // The two side buttons, "back" and "forward" on most mice.
    X1
    X2

    Other(code: u8)

    code(self) -> u8
        self match
            Left -> BUTTON_LEFT
            Middle -> BUTTON_MIDDLE
            Right -> BUTTON_RIGHT
            X1 -> BUTTON_X1
            X2 -> BUTTON_X2
            Other(n) -> n

    of(code: u8) -> MouseButton
        code match
            BUTTON_LEFT -> Left
            BUTTON_MIDDLE -> Middle
            BUTTON_RIGHT -> Right
            BUTTON_X1 -> X1
            BUTTON_X2 -> X2
            n -> Other(n)
end MouseButton

impl Eq for MouseButton
    eq(self, other: MouseButton) -> bool = self.code() == other.code()

impl Display for MouseButton
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Left -> "left"
            Middle -> "middle"
            Right -> "right"
            X1 -> "x1"
            X2 -> "x2"
            Other(_) -> "an unknown button"

        display_str(s, out, fmt)

// Where the pointer is and which buttons are down.
//
// The button field is a **mask**, not a `MouseButton`: several may be down at once, which is
// exactly what an enumeration cannot say. `c`'s `BUTTON_*MASK` values name the bits.
struct MouseState
    buttons: u32
    x: f32
    y: f32

    left(self) -> bool = (self.buttons & BUTTON_LMASK) != 0
    middle(self) -> bool = (self.buttons & BUTTON_MMASK) != 0
    right(self) -> bool = (self.buttons & BUTTON_RMASK) != 0
end MouseState

// The pointer's position in the focused window's coordinates, and its buttons.
mouse_state() -> MouseState
    var x: f32 = 0.0
    var y: f32 = 0.0
    val b = c.get_mouse_state(&x, &y)

    MouseState(b, x, y)
end mouse_state

// The same in desktop coordinates, which is what a program dragging something outside its own
// window needs.
global_mouse_state() -> MouseState
    var x: f32 = 0.0
    var y: f32 = 0.0
    val b = c.get_global_mouse_state(&x, &y)

    MouseState(b, x, y)
end global_mouse_state

// Move the pointer to a point in a window.
warp_mouse(window: &Window, x: f32, y: f32) = c.warp_mouse_in_window(window.handle, x, y)

// ## Cursors
//
// The pointer's shape is process-wide rather than per-window: setting one changes it everywhere
// until the next set. A program that wants a resize arrow over a divider and an I-beam over text
// builds the shapes it needs once — they are cheap, and SDL caches the platform cursor behind each
// — keeps the handles, and sets one as the pointer moves.
//
// **There are two cursor types and the difference is ownership, which SDL gives no other way to
// express.** A cursor this program made is a `&Cursor` and goes when the last reference does. A
// cursor SDL *lends* — the current one, the platform's default — is a `BorrowedCursor`, which can
// be made active and nothing else. Cairo could take a reference on a lent object and hand back one
// type; SDL has no `SDL_ReferenceCursor`, so the honest answer is that they are different things.

// One of the built-in shapes.
enum SystemCursor
    Default
    Text
    Wait
    Crosshair
    Progress

    // The two families of resize cursor look the same on most platforms: `NwseResize`, `NeswResize`,
    // `EwResize` and `NsResize` are the diagonal and axis double-arrows, while the per-edge `NResize`
    // and so on let a platform draw a directional single arrow where it has one.
    NwseResize
    NeswResize
    EwResize
    NsResize

    Move
    NotAllowed
    Pointer

    NwResize
    NResize
    NeResize
    EResize
    SeResize
    SResize
    SwResize
    WResize

    code(self) -> i32
        self match
            Default -> SYSTEM_CURSOR_DEFAULT
            Text -> SYSTEM_CURSOR_TEXT
            Wait -> SYSTEM_CURSOR_WAIT
            Crosshair -> SYSTEM_CURSOR_CROSSHAIR
            Progress -> SYSTEM_CURSOR_PROGRESS
            NwseResize -> SYSTEM_CURSOR_NWSE_RESIZE
            NeswResize -> SYSTEM_CURSOR_NESW_RESIZE
            EwResize -> SYSTEM_CURSOR_EW_RESIZE
            NsResize -> SYSTEM_CURSOR_NS_RESIZE
            Move -> SYSTEM_CURSOR_MOVE
            NotAllowed -> SYSTEM_CURSOR_NOT_ALLOWED
            Pointer -> SYSTEM_CURSOR_POINTER
            NwResize -> SYSTEM_CURSOR_NW_RESIZE
            NResize -> SYSTEM_CURSOR_N_RESIZE
            NeResize -> SYSTEM_CURSOR_NE_RESIZE
            EResize -> SYSTEM_CURSOR_E_RESIZE
            SeResize -> SYSTEM_CURSOR_SE_RESIZE
            SResize -> SYSTEM_CURSOR_S_RESIZE
            SwResize -> SYSTEM_CURSOR_SW_RESIZE
            WResize -> SYSTEM_CURSOR_W_RESIZE
end SystemCursor

impl Display for SystemCursor
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Default -> "default"
            Text -> "text"
            Wait -> "wait"
            Crosshair -> "crosshair"
            Progress -> "progress"
            NwseResize -> "nwse resize"
            NeswResize -> "nesw resize"
            EwResize -> "ew resize"
            NsResize -> "ns resize"
            Move -> "move"
            NotAllowed -> "not allowed"
            Pointer -> "pointer"
            NwResize -> "nw resize"
            NResize -> "n resize"
            NeResize -> "ne resize"
            EResize -> "e resize"
            SeResize -> "se resize"
            SResize -> "s resize"
            SwResize -> "sw resize"
            WResize -> "w resize"

        display_str(s, out, fmt)

// A mouse pointer shape this program made and owns.
struct Cursor
    handle: *c.Cursor

    // Make this the active shape, everywhere. `true` on success.
    set(&self) -> bool = c.set_cursor(self.handle)
end Cursor

// It goes when the last reference does. This is why the type is separate from `BorrowedCursor`:
// SDL's own cursors must never reach here.
impl Drop for Cursor
    drop(self) = c.destroy_cursor(self.handle)

// A cursor SDL owns and lends. It can be made active and nothing else — there is no way to free one
// from here, which is the point.
struct BorrowedCursor
    handle: *c.Cursor

    set(self) -> bool = c.set_cursor(self.handle)
end BorrowedCursor

// One of the built-in shapes. Nothing if the platform cannot make it.
create_system_cursor(id: SystemCursor) -> Option[&Cursor]
    val h = c.create_system_cursor(id.code())

    if h == null then None else Some(Cursor(h))
end create_system_cursor

// The shape currently set, or nothing when the default is in effect and none was set.
current_cursor() -> Option[BorrowedCursor]
    val h = c.get_cursor()

    if h == null then None else Some(BorrowedCursor(h))
end current_cursor

// The platform's own default, the arrow — what a program restores to after showing something else.
default_cursor() -> Option[BorrowedCursor]
    val h = c.get_default_cursor()

    if h == null then None else Some(BorrowedCursor(h))
end default_cursor

// Show the pointer — it is visible to begin with. Visibility is independent of which shape is set.
show_cursor() -> bool = c.show_cursor()

// Hide it, for a video player's idle chrome or a game that draws its own.
hide_cursor() -> bool = c.hide_cursor()

cursor_visible() -> bool = c.cursor_visible()
