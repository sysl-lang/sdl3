const SCANCODE_O: i32 = 18
const SCANCODE_P: i32 = 19
const SCANCODE_Q: i32 = 20
const SCANCODE_R: i32 = 21
const SCANCODE_S: i32 = 22
const SCANCODE_T: i32 = 23
const SCANCODE_U: i32 = 24
const SCANCODE_V: i32 = 25
