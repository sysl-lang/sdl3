module sh.sysl.sdl3

import sh.sysl.sdl3.c
import sh.sysl.sdl3.c.{Rect, FRect, FPoint}
import sysl.text.cstring

// Windows, displays, and the text input that belongs to a window.
//
// **Text input is here rather than beside the keyboard in `input.sysl` because SDL scopes it to a
// window**, which is what lets two fields in two windows be edited independently — and because on a
// phone it is a window question rather than a keyboard one: where the field is decides where the
// on-screen keyboard puts itself and what it covers.
//
// **A handle is reached through `&T` and frees what it points at when the last reference goes.**
// SDL allocates the object and SDL frees it, so there is no size for this side to know — but there
// *is* an owner, and saying so in the type is what removes the `destroy` that used to be written by
// hand. A window closed twice, or read after it was closed, is no longer something a program can
// express.
//
// **Anything that creates a handle answers `Option`.** SDL says "failed" with a null pointer and
// the reason in `error()`; an `Option` is the same information in the shape the rest of the
// language already reads, and it means a null handle cannot be passed on by accident.
//
// **A rectangle is `c.Rect` or `c.FRect`** — SDL's own layout, since these cross to C by pointer
// and there is nothing about four numbers for this layer to improve. `rect` and `frect` build one
// without naming the type; a consumer that wants the name imports it from `c`.

// What a field is for, which is what a phone reads to decide which keyboard to put on the screen. On
// a desktop it changes nothing — which is why a field that offers a PIN pad on a phone and a full
// keyboard on a laptop is easy to get wrong and easy not to notice.
enum TextInputType
    Text
    Name
    Email
    Username
    PasswordHidden
    PasswordVisible
    Number
    PinHidden
    PinVisible

    Other(code: i32)

    code(self) -> i32
        self match
            Text -> c.TEXTINPUT_TYPE_TEXT
            Name -> c.TEXTINPUT_TYPE_TEXT_NAME
            Email -> c.TEXTINPUT_TYPE_TEXT_EMAIL
            Username -> c.TEXTINPUT_TYPE_TEXT_USERNAME
            PasswordHidden -> c.TEXTINPUT_TYPE_TEXT_PASSWORD_HIDDEN
            PasswordVisible -> c.TEXTINPUT_TYPE_TEXT_PASSWORD_VISIBLE
            Number -> c.TEXTINPUT_TYPE_NUMBER
            PinHidden -> c.TEXTINPUT_TYPE_NUMBER_PASSWORD_HIDDEN
            PinVisible -> c.TEXTINPUT_TYPE_NUMBER_PASSWORD_VISIBLE
            Other(n) -> n

    of(code: i32) -> TextInputType
        code match
            c.TEXTINPUT_TYPE_TEXT -> Text
            c.TEXTINPUT_TYPE_TEXT_NAME -> Name
            c.TEXTINPUT_TYPE_TEXT_EMAIL -> Email
            c.TEXTINPUT_TYPE_TEXT_USERNAME -> Username
            c.TEXTINPUT_TYPE_TEXT_PASSWORD_HIDDEN -> PasswordHidden
            c.TEXTINPUT_TYPE_TEXT_PASSWORD_VISIBLE -> PasswordVisible
            c.TEXTINPUT_TYPE_NUMBER -> Number
            c.TEXTINPUT_TYPE_NUMBER_PASSWORD_HIDDEN -> PinHidden
            c.TEXTINPUT_TYPE_NUMBER_PASSWORD_VISIBLE -> PinVisible
            n -> Other(n)
end TextInputType

impl Eq for TextInputType
    eq(self, other: TextInputType) -> bool = self.code() == other.code()

impl Display for TextInputType
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Text -> "text"
            Name -> "a name"
            Email -> "an e-mail address"
            Username -> "a username"
            PasswordHidden -> "a hidden password"
            PasswordVisible -> "a visible password"
            Number -> "a number"
            PinHidden -> "a hidden pin"
            PinVisible -> "a visible pin"
            Other(_) -> "an input type this binding does not name"

        display_str(s, out, fmt)

// What the platform capitalizes on its own while the user types.
enum Capitalization
    // `Off` rather than `None`, because an enum variant is reachable unqualified inside the module
    // and a second `None` here would shadow `Option`'s for every file in it. `BlendMode.Off` is the
    // same rename for the same reason.
    Off
    Sentences
    Words
    Letters

    Other(code: i32)

    code(self) -> i32
        self match
            Off -> c.CAPITALIZE_NONE
            Sentences -> c.CAPITALIZE_SENTENCES
            Words -> c.CAPITALIZE_WORDS
            Letters -> c.CAPITALIZE_LETTERS
            Other(n) -> n

    of(code: i32) -> Capitalization
        code match
            c.CAPITALIZE_NONE -> Off
            c.CAPITALIZE_SENTENCES -> Sentences
            c.CAPITALIZE_WORDS -> Words
            c.CAPITALIZE_LETTERS -> Letters
            n -> Other(n)
end Capitalization

impl Eq for Capitalization
    eq(self, other: Capitalization) -> bool = self.code() == other.code()

impl Display for Capitalization
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Off -> "off"
            Sentences -> "sentences"
            Words -> "words"
            Letters -> "letters"
            Other(_) -> "a capitalization this binding does not name"

        display_str(s, out, fmt)

// Whether the system is set light or dark. `Unknown` is an ordinary answer and not a failure — a
// platform that has no such setting reports it, and an interface should have a colour scheme it
// falls back to rather than treating it as an error.
enum SystemTheme
    Unknown
    Light
    Dark

    Other(code: i32)

    code(self) -> i32
        self match
            Unknown -> c.SYSTEM_THEME_UNKNOWN
            Light -> c.SYSTEM_THEME_LIGHT
            Dark -> c.SYSTEM_THEME_DARK
            Other(n) -> n

    of(code: i32) -> SystemTheme
        code match
            c.SYSTEM_THEME_UNKNOWN -> Unknown
            c.SYSTEM_THEME_LIGHT -> Light
            c.SYSTEM_THEME_DARK -> Dark
            n -> Other(n)
end SystemTheme

impl Eq for SystemTheme
    eq(self, other: SystemTheme) -> bool = self.code() == other.code()

impl Display for SystemTheme
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Unknown -> "unknown"
            Light -> "light"
            Dark -> "dark"
            Other(_) -> "a theme this binding does not name"

        display_str(s, out, fmt)

// A rectangle in integer screen coordinates.
rect(x: i32, y: i32, w: i32, h: i32) -> Rect = Rect(x, y, w, h)

// A rectangle in the floating-point coordinates the renderer works in. Every drawing call takes
// these, which is the change from SDL2 that removed its 16-bit clamping.
frect(x: f32, y: f32, w: f32, h: f32) -> FRect = FRect(x, y, w, h)

// A point in renderer coordinates.
fpoint(x: f32, y: f32) -> FPoint = FPoint(x, y)

// An operating-system window.
struct Window
    handle: *c.Window

    // Make a renderer for this window. `name` selects a render driver by name; the empty string
    // lets SDL pick the best one, which is what a program almost always wants.
    create_renderer(&self, name: string = "") -> Option[&Renderer]
        val r = if name == "" then
                c.create_renderer(self.handle, null)
            else
                val n = cstring(name)

                c.create_renderer(self.handle, n.ptr)

        if r == null then None else Some(Renderer(r))
    end create_renderer

    // SDL3 has no creation-time position, so a window that wants one sets it here. `x` and `y` may
    // be `c.WINDOWPOS_CENTERED` or `c.WINDOWPOS_UNDEFINED`.
    set_position(&self, x: i32, y: i32) -> bool = c.set_window_position(self.handle, x, y)

    position(&self) -> (i32, i32)
        var x: i32 = 0
        var y: i32 = 0

        c.get_window_position(self.handle, &x, &y)
        (x, y)
    end position

    set_size(&self, w: i32, h: i32) -> bool = c.set_window_size(self.handle, w, h)

    // The logical size, in screen coordinates.
    size(&self) -> (i32, i32)
        var w: i32 = 0
        var h: i32 = 0

        c.get_window_size(self.handle, &w, &h)
        (w, h)
    end size

    // The size in physical pixels, which differs from `size` on a high-density display. A renderer
    // owning a backbuffer sizes it from this one.
    size_in_pixels(&self) -> (i32, i32)
        var w: i32 = 0
        var h: i32 = 0

        c.get_window_size_in_pixels(self.handle, &w, &h)
        (w, h)
    end size_in_pixels

    pixel_format(&self) -> PixelFormat = PixelFormat.of(c.get_window_pixel_format(self.handle))

    // **The scale to draw content at, and the number an interface is laid out in.** Multiply a size
    // written in device-independent units by this and the result is the same physical size on every
    // display: 16 units of text is legible on a laptop panel, an external monitor and a phone, and
    // 16 *pixels* is legible on one of them.
    //
    // **This is the one to reach for, and `pixel_density` is not.** The density below says only how
    // many pixels back a unit of window; this combines it with what the user asked for in the
    // display's own settings, which is the part that makes a phone's 2.75 different from a retina
    // laptop's 2.0 despite similar hardware. SDL's own wording is that this "is the expected scale
    // for displaying content in this window".
    //
    // **It changes while the program runs** — the window is dragged to another monitor, or the
    // setting itself is changed — and `EventKind.WindowDisplayScaleChanged` is what says so. Ask
    // again there rather than reading it once at startup.
    //
    // **A failure answers `1.0` rather than SDL's `0.0`.** There is nothing a caller could do with
    // zero except substitute one, and a zero that reached a layout would multiply every size in it
    // to nothing — a whole interface drawn correctly at no size at all, which is a far worse failure
    // than an unscaled one. So the substitution is made once, here.
    display_scale(&self) -> f32
        val s = c.get_window_display_scale(self.handle)

        if s == 0.0 then 1.0 else s
    end display_scale

    // How many pixels the window's backbuffer holds per unit of its logical size — 2.0 for a 1920x1080
    // window with a 3840x2160 backbuffer. It is the ratio between `size` and `size_in_pixels` and
    // nothing more.
    //
    // **What this is for is pixels, not layout.** A program allocating a texture to cover part of the
    // window, or reading back a region, sizes it with this; a program deciding how big a button
    // should be wants `display_scale`. Reaching for this one to lay out gives an interface that is
    // the right number of pixels and the wrong physical size.
    pixel_density(&self) -> f32
        val d = c.get_window_pixel_density(self.handle)

        if d == 0.0 then 1.0 else d
    end pixel_density

    // The part of the window it is safe to put something the user has to see or touch.
    //
    // **On a desktop this is the whole window and asking is a formality. On a phone it is the
    // point.** A modern Android app draws edge to edge whether it asks to or not — from API 35 that
    // is the default and there is no opting out — so the surface extends under the status bar at the
    // top and the gesture bar at the bottom, and under a camera cutout if the device has one. A
    // program that lays out against `size` puts its buttons under the system's own, and the pixels
    // are drawn correctly and cannot be tapped. iOS has had the same shape since the notch.
    //
    // **This is the alternative to going fullscreen, not a supplement to it.** `set_fullscreen(true)`
    // hides the bars and gives the program the glass, which is what a game wants; a program that
    // keeps them wants this instead. Fullscreen makes the safe area the whole window, so code
    // written against this stays correct either way — which is the argument for writing against it
    // by default.
    safe_area(&self) -> Rect
        var r = Rect(0, 0, 0, 0)

        // A failure leaves the rectangle as it is rather than being reported, which is the one place
        // this differs from the C. There is nothing a caller could usefully do with `false` except
        // fall back to the whole window, and that is what SDL itself answers with when it has no
        // insets to report — so the fallback is the answer, and returning it directly saves every
        // caller writing the same three lines.
        if !c.get_window_safe_area(self.handle, &r)
            val (w, h) = self.size()

            return Rect(0, 0, w, h)

        r
    end safe_area

    // The window's current state, as a mask of `c`'s `WINDOW_*` values. This is what a program asks
    // to find out whether a resize left it maximized, or whether it still has input focus, without
    // keeping its own record from the events.
    flags(&self) -> u64 = c.get_window_flags(self.handle)

    set_title(&self, title: string) -> bool
        val t = cstring(title)

        c.set_window_title(self.handle, t.ptr)
    end set_title

    set_fullscreen(&self, on: bool) -> bool = c.set_window_fullscreen(self.handle, on)

    set_resizable(&self, on: bool) -> bool = c.set_window_resizable(self.handle, on)

    show(&self) -> bool = c.show_window(self.handle)

    hide(&self) -> bool = c.hide_window(self.handle)

    raise(&self) -> bool = c.raise_window(self.handle)

    // The id events carry in their `window_id` field, which is how a program with more than one
    // window tells which an event belongs to.
    id(&self) -> u32 = c.get_window_id(self.handle)

    // Begin delivering `EventKind.TextInput` for this window, and bring up the platform's on-screen
    // or IME keyboard where it has one. A text field turns this on when it takes focus and off when
    // it loses it; the typed text is read with `Event.text`.
    start_text_input(&self) -> bool = c.start_text_input(self.handle)

    // The same, saying what the field is for — which is what a phone reads to choose the keyboard it
    // puts on the screen. A `Number` field gets a digit pad, a `PasswordHidden` one gets no
    // suggestions and no history, an `Email` one gets an `@` on the front row.
    //
    // **The three `Option` parameters mean "let SDL decide", and passing a value where you meant
    // that is the mistake this shape exists to prevent.** SDL derives each of them from the input
    // type when it is not set: capitalization is `Sentences` for ordinary text, `Words` for a name,
    // and `None` for an e-mail address, a username or a password — so a wrapper that always sent a
    // capitalization would capitalize e-mail addresses, and one that always sent `Sentences` would
    // do it in every field. `multiline` is likewise derived, from `SDL_HINT_RETURN_KEY_HIDES_IME`.
    // Only what is asked for is set.
    //
    start_text_input_with(&self, kind: TextInputType = TextInputType.Text,
                          capitalize: Option[Capitalization] = None,
                          autocorrect: Option[bool] = None,
                          multiline: Option[bool] = None) -> bool
        val props = create_properties()

        set_number_property(props, "SDL.textinput.type", i64(kind.code()))

        capitalize match
            Some(cap) -> set_number_property(props, "SDL.textinput.capitalization", i64(cap.code()))
            None -> ()

        autocorrect match
            Some(on) -> set_boolean_property(props, "SDL.textinput.autocorrect", on)
            None -> ()

        multiline match
            Some(on) -> set_boolean_property(props, "SDL.textinput.multiline", on)
            None -> ()

        val ok = c.start_text_input_with_properties(self.handle, props)

        destroy_properties(props)
        ok
    end start_text_input_with

    stop_text_input(&self) -> bool = c.stop_text_input(self.handle)

    // Whether text input is on for this window, which is what a field asks rather than keeping its
    // own flag beside SDL's.
    text_input_active(&self) -> bool = c.text_input_active(self.handle)

    // Throw away an input method's composition in progress. A field that loses focus, or is cleared
    // while a CJK keyboard is mid-word, calls this — otherwise the half-formed text commits into
    // whatever takes focus next.
    clear_composition(&self) -> bool = c.clear_composition(self.handle)

    // **Where the text being edited is, and it is not optional on a phone.** The platform needs the
    // rectangle for two things: to put an input method's suggestion window beside the text rather
    // than over it, and — the one that matters on a small screen — to scroll the field above the
    // on-screen keyboard when the keyboard comes up. Without it a field in the lower half of a phone
    // is covered by the keyboard the moment it is tapped, and the user types blind.
    //
    // `cursor` is the caret's offset from the rectangle's left edge, in the same window coordinates.
    // Call it again whenever the caret or the layout moves.
    set_text_input_area(&self, r: Rect, cursor: i32) -> bool
        var v = r

        c.set_text_input_area(self.handle, &v, cursor)
    end set_text_input_area

    // Forget the area, which is what a field does when it stops being edited.
    clear_text_input_area(&self) -> bool = c.set_text_input_area(self.handle, null, 0)

    // What was last set, or nothing where SDL cannot say.
    text_input_area(&self) -> Option[(Rect, i32)]
        var r = Rect(0, 0, 0, 0)
        var cursor: i32 = 0

        if c.get_text_input_area(self.handle, &r, &cursor) then Some((r, cursor)) else None
    end text_input_area

    // Whether the on-screen keyboard is up *right now*. A layout that has to keep a field visible
    // asks this and shrinks itself; a desktop always answers false.
    screen_keyboard_shown(&self) -> bool = c.screen_keyboard_shown(self.handle)

    // The display this window is mostly on, or 0 if SDL cannot tell.
    display(&self) -> u32 = c.get_display_for_window(self.handle)
end Window

// The window goes when the last reference to it does. A renderer made from a window holds no
// reference of its own — that is SDL's arrangement rather than this one's — so a program that keeps
// the renderer and drops the window has done something SDL will not survive, exactly as in C.
impl Drop for Window
    drop(self) = c.destroy_window(self.handle)

// Create a window. `flags` is a mask of `c`'s `WINDOW_*` values.
create_window(title: string, width: i32, height: i32, flags: u64 = 0) -> Option[&Window]
    val t = cstring(title)
    val w = c.create_window(t.ptr, width, height, flags)

    if w == null then None else Some(Window(w))
end create_window

// Whether this platform has an on-screen keyboard at all. It is a property of the machine rather
// than of a window, and it is what decides whether a program needs to lay out around one — a desktop
// answers false and a phone answers true whether or not the keyboard happens to be up.
has_screen_keyboard_support() -> bool = c.has_screen_keyboard_support()

// Whether the system is set light or dark.
//
// **Ask again on `EventKind.SystemThemeChanged` rather than reading it once.** A phone switches at
// sunset on a schedule the program is not told about in advance, and a desktop switches when the
// user does — an interface that read this at startup is the wrong colour for the rest of the session.
system_theme() -> SystemTheme = SystemTheme.of(c.get_system_theme())

// The id of the primary display, or 0 if none is reported.
primary_display() -> u32 = c.get_primary_display()

// A display's whole area in screen coordinates.
display_bounds(display: u32) -> Option[Rect]
    var r = Rect(0, 0, 0, 0)

    if c.get_display_bounds(display, &r) then Some(r) else None
end display_bounds

// A display's *usable* area — the desktop minus whatever the system reserves, a menu bar or a
// taskbar. A window sized within it stays fully visible, which is what a program that wants to open
// "as large as fits" should measure against rather than `display_bounds`.
display_usable_bounds(display: u32) -> Option[Rect]
    var r = Rect(0, 0, 0, 0)

    if c.get_display_usable_bounds(display, &r) then Some(r) else None
end display_usable_bounds

// A display's content scale, for a program that has to size something *before* it has a window to
// ask. Once there is a window, `Window.display_scale` is the one to use — it answers for the display
// the window is actually on, and keeps answering as it moves between them.
//
// A failure answers `1.0`, for the reason `Window.display_scale` gives.
display_content_scale(display: u32) -> f32
    val s = c.get_display_content_scale(display)

    if s == 0.0 then 1.0 else s
end display_content_scale
