// SDL3, declared verbatim.
//
// **The declarations over the library the machine has.** Nothing here is meant to be called by a
// program: every name and every convention is C's, so a window is a pointer, a failure is `false`
// with the reason somewhere else, and a rectangle is four numbers with no methods on them. The
// module above this one turns those into sysl and is what an application imports.
//
// **What decides which module a thing goes in is whether an APPLICATION has to name it, not whether
// it is a C artifact.** SDL's numbers moved to `constants.sysl` in the module above for exactly that
// reason — they are `c const` blocks and they carry a header clause, and they are still no business
// of a program's import list to reach in here for. Nothing in this file ever read one.
//
// The split keeps two jobs apart. This one has to be **faithful** — a signature that disagrees with
// the header links perfectly and corrupts the call at run time, and nothing in this arrangement
// checks one against the other, so each declaration below was read out of SDL3's headers rather
// than remembered. The other one has to be **pleasant**, which is a different question and would
// otherwise be answered in the same breath.
//
// **There is no shim, which is the interesting half.** SDL3 needs none of the three things `15 §7`
// lists as reachable from C and from nothing else: every handle is a pointer SDL allocates and SDL
// frees, so this side never needs a size; `SDL_Surface` is public and ABI-stable in SDL3, so its
// fields are read straight out of SDL's storage; and the constants come from `c const` rather than
// from a wrapper function each. The whole of the surface bound here is reachable by declaring it.

module sh.sysl.sdl3.c
@link("SDL3")

// ## The handles
//
// Five of SDL's objects are opaque: it allocates them, it frees them, and nothing outside the
// library knows their size. An `opaque struct` is exactly that claim, and it is what stops
// `destroy_texture` accepting a window.

opaque struct Window
opaque struct Renderer
opaque struct Texture
opaque struct Cursor
opaque struct AudioStream

// `SDL_Surface`, which is **not** opaque. SDL3 made it public and ABI-stable, so the fields are read
// through a pointer to SDL's own storage rather than copied out by a shim — that is why there is no
// shim in this package for it. `flags` is a `Uint32`, and getting that wrong shifts every field
// after it, which shows up as a pitch narrower than the width rather than as anything that mentions
// layout. `tests.sysl` checks the size against C's.
struct Surface
    flags: u32
    format: i32
    w: i32
    h: i32
    pitch: i32
    pixels: *u8
    refcount: i32
    reserved: *u8

// ## The structs that cross by value or by pointer

// `SDL_Rect` — integer screen coordinates.
struct Rect
    x: i32
    y: i32
    w: i32
    h: i32

// `SDL_FRect` — the floating-point coordinates the renderer works in. Every drawing call takes
// these, which is the change from SDL2 that removed its 16-bit clamping.
struct FRect
    x: f32
    y: f32
    w: f32
    h: f32

// `SDL_FPoint` — a point in those same coordinates.
struct FPoint
    x: f32
    y: f32

// `SDL_Vertex` — position, colour in 0..1, and texture coordinates. Eight contiguous floats with no
// padding, which is what `SDL_RenderGeometry` reads.
struct Vertex
    x: f32
    y: f32
    r: f32
    g: f32
    b: f32
    a: f32
    u: f32
    v: f32

// `SDL_AudioSpec` — three contiguous 32-bit words.
struct AudioSpec
    format: i32
    channels: i32
    freq: i32

// `SDL_Locale` — two C strings, the second of which is null when the platform names no region.
struct Locale
    language: *u8
    country: *u8

// `SDL_DialogFileFilter` — two pointers, which is what SDL reads the array as.
struct DialogFileFilter
    name: *u8
    pattern: *u8

// ## The event union
//
// **`SDL_Event` is a union of about thirty structs in 128 bytes.** It is declared here as the header
// every event begins with and a view struct per variant that the module above reinterprets into. The
// layout is SDL3's stable 64-bit ABI and `tests.sysl` pins the size against what C computes, which is
// the check that a field added to the wrong view would fail.

@align(8)
struct Event
    kind: u32
    reserved: u32
    timestamp: u64
    body: [112]u8

@align(8)
struct KeyboardEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    which: u32
    scancode: i32
    key: u32
    mod: u16
    raw: u16
    down: bool
    repeat: bool
    tail: [90]u8

@align(8)
struct MouseMotionEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    which: u32
    state: u32
    x: f32
    y: f32
    xrel: f32
    yrel: f32
    tail: [84]u8

@align(8)
struct MouseButtonEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    which: u32
    button: u8
    down: bool
    clicks: u8
    pad: u8
    x: f32
    y: f32
    tail: [88]u8

@align(8)
struct MouseWheelEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    which: u32
    x: f32
    y: f32
    direction: u32
    mouse_x: f32
    mouse_y: f32
    tail: [84]u8

// **The one view whose coordinates do not start where the others' do.** `SDL_TouchID` and
// `SDL_FingerID` are both `Uint64`, so sixteen bytes of ids sit between the header and the floats
// and `x` begins at byte 32 — where every mouse variant has its own `x` by 28 at the latest. The
// window id is at the *end* here rather than the front, which is the other way round from the rest
// of the union.
//
// A coordinate read from the wrong offset is still a float and still draws something, so nothing
// about this fails loudly; `tests.sysl` reads all six fields back through the accessors, which is
// what pins it.
@align(8)
struct TouchFingerEvent
    kind: u32
    reserved: u32
    timestamp: u64
    touch_id: u64
    finger_id: u64
    x: f32
    y: f32
    dx: f32
    dy: f32
    pressure: f32
    window_id: u32
    tail: [72]u8

@align(8)
struct TextEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    pad: u32
    text: *u8
    tail: [96]u8

// **`SDL_TextEditingEvent` is `SDL_TextInputEvent` with two more words on the end**, and the two
// arrive under different kinds — so the shared prefix is why `Event.text` reads either and the
// suffix is why this needs a view of its own. `start` and `length` are the selected range within the
// composition, both `-1` when the platform does not say.
@align(8)
struct TextEditingEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    pad: u32
    text: *u8
    start: i32
    length: i32
    tail: [88]u8

@align(8)
struct DropEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    x: f32
    y: f32
    pad: u32
    source: *u8
    data: *u8
    tail: [80]u8

@align(8)
struct WindowEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    data1: i32
    data2: i32
    tail: [100]u8

@align(8)
struct UserEvent
    kind: u32
    reserved: u32
    timestamp: u64
    window_id: u32
    code: i32
    data1: *u8
    data2: *u8
    tail: [88]u8

