// ### Touch, and the two sentinels that keep it apart from the mouse
//
// **SDL delivers every touch twice**, and a program that reads both handles every tap twice. A
// finger produces its own `SDL_EVENT_FINGER_*` *and* a synthesized mouse event, and on a platform
// driven by a mouse the reverse also happens — so each carries a sentinel in the field naming the
// device it came from, and comparing against it is how one of the two pairs is dropped.
//
// `SDL_TOUCH_MOUSEID` is the `which` of a mouse event that was really a finger; `SDL_MOUSE_TOUCHID`
// is the `touchID` of a finger event that was really the mouse. Both are `-1` cast to their own id
// type, which is why one is 32 bits and the other 64.
c const
    TOUCH_MOUSEID: u32 = "SDL_TOUCH_MOUSEID"
    MOUSE_TOUCHID: u64 = "SDL_MOUSE_TOUCHID"

// ### What a text field is for (SDL_TextInputType)
//
// **This is what chooses the keyboard a phone puts on the screen**, and it is the difference between
// a PIN field offering ten digits and offering a full QWERTY. On a desktop it changes nothing, which
// is why it is easy to leave out and be told about later.
c const
    TEXTINPUT_TYPE_TEXT:                    i32 = "SDL_TEXTINPUT_TYPE_TEXT"
    TEXTINPUT_TYPE_TEXT_NAME:               i32 = "SDL_TEXTINPUT_TYPE_TEXT_NAME"
    TEXTINPUT_TYPE_TEXT_EMAIL:              i32 = "SDL_TEXTINPUT_TYPE_TEXT_EMAIL"
    TEXTINPUT_TYPE_TEXT_USERNAME:           i32 = "SDL_TEXTINPUT_TYPE_TEXT_USERNAME"
    TEXTINPUT_TYPE_TEXT_PASSWORD_HIDDEN:    i32 = "SDL_TEXTINPUT_TYPE_TEXT_PASSWORD_HIDDEN"
    TEXTINPUT_TYPE_TEXT_PASSWORD_VISIBLE:   i32 = "SDL_TEXTINPUT_TYPE_TEXT_PASSWORD_VISIBLE"
    TEXTINPUT_TYPE_NUMBER:                  i32 = "SDL_TEXTINPUT_TYPE_NUMBER"
    TEXTINPUT_TYPE_NUMBER_PASSWORD_HIDDEN:  i32 = "SDL_TEXTINPUT_TYPE_NUMBER_PASSWORD_HIDDEN"
    TEXTINPUT_TYPE_NUMBER_PASSWORD_VISIBLE: i32 = "SDL_TEXTINPUT_TYPE_NUMBER_PASSWORD_VISIBLE"

