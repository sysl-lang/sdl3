module sh.sysl.sdl3

import sh.sysl.sdl3.c
import sh.sysl.sdl3.c.INIT_VIDEO
import sysl.text.{cstring, from_cstring}

// SDL3 — a window, a renderer, an event queue, input and audio.
//
// **This package binds a library the machine already has, and carries no C of its own.** Unlike
// linenoise, monocypher or qcbor, whose sources are vendored so that nothing has to be installed,
// SDL is a large C project with its own build system and its own platform backends; a package
// carrying it would be maintaining a port. So SDL3 is installed separately and the two flags naming
// its prefix are part of every build here — `package.hocon` says why that is deliberate.
//
// **It is two layers.** `sh.sysl.sdl3.c` holds everything that is C — the link directive, the
// headers, the `c const` blocks that ask the C compiler for SDL's numbers, the opaque handles and
// the hundred and thirty declarations. This module is what an application imports, and its job is
// to be pleasant rather than faithful: a handle owns what it points at and frees it when the last
// reference goes, a failure is an `Option` rather than a null, and a value out of an enumeration is
// a variant with a name rather than a number.
//
// **A consumer may reach into `c` and that is fine** — SDL's masks and scancodes live there, since
// they are SDL's own numbers and there is nothing for this layer to improve about them:
//
//     import sh.sysl.sdl3.*
//     import sh.sysl.sdl3.c.{WINDOW_RESIZABLE, SCANCODE_ESCAPE}
//
// **`SDL_Surface` is public and ABI-stable in SDL3**, so its fields are read straight out of SDL's
// storage rather than copied out by a shim. That is a change from SDL2, where it was opaque, and it
// is half of why this package needs no C of its own.
//
// **A call that fails answers `false` or nothing, and the reason is in `error()`.** That is SDL's
// convention and it is kept rather than translated into `Result`: a binding that invented a richer
// answer than the library gives would be inventing the failure cases too.

// ## Lifecycle

// Tell SDL the program supplies its own `main`, which a sysl program always does — there is no
// place for SDL's main shim to sit. Call it before `init`.
set_main_ready() = c.set_main_ready()

// Bring up the named subsystems; `false` on failure, with the reason in `error`. `flags` is a mask
// of `c`'s `INIT_*` values.
init(flags: u32 = INIT_VIDEO) -> bool = c.init(flags)

// Bring up a subsystem after `init` has already run — audio is independent of video, so a program
// that opens a window first and decides about sound later asks for it here.
init_subsystem(flags: u32) -> bool = c.init_sub_system(flags)

quit_subsystem(flags: u32) = c.quit_sub_system(flags)

quit() = c.quit()

// Which of the asked-for subsystems are up, as the same mask. Zero for none of them.
was_init(flags: u32) -> u32 = c.was_init(flags)

// What went wrong with the last call that said so. SDL owns the storage and reuses it, so the text
// is copied out here rather than pointed at.
error() -> string = from_cstring(c.get_error()).unwrap_or("")

// ## The clock
//
// **This is the only clock a sysl program has**, since the language itself has no time source, and
// it is a monotonic one: it counts from `init` and cannot go backwards or jump when somebody
// changes the system time. That makes it right for the two things a program asks a clock for here —
// how long the last frame took, and how long since something happened — and useless for the date,
// which SDL does not answer either.

// Sleep for at least this many milliseconds. The floor is the platform's timer granularity, so a
// frame loop that wants a rate should measure rather than count delays — `ticks` below is what it
// measures with.
delay(ms: u32) = c.delay(ms)

// The same in nanoseconds, and the same caveat: the sleep is *at least* this long.
delay_ns(ns: u64) = c.delay_ns(ns)

// A sleep that spins out the last of the interval rather than handing the whole of it to the
// scheduler. Accurate to well under a millisecond and it costs a core while it waits, which is the
// trade — it is for pacing a frame, not for idling.
delay_precise(ns: u64) = c.delay_precise(ns)

// Milliseconds since `init`.
ticks() -> u64 = c.get_ticks()

// The same in nanoseconds, which is what a frame time wants: at 120 Hz a frame is eight
// milliseconds, so a millisecond clock measures it to one part in eight.
ticks_ns() -> u64 = c.get_ticks_ns()

// The raw counter behind both, and the ticks per second to divide it by. `ticks_ns` is this pair
// already divided; reach for the counter itself only where the division would lose something —
// timing a run of a few microseconds, or accumulating a total without rounding at every step.
performance_counter() -> u64 = c.get_performance_counter()

performance_frequency() -> u64 = c.get_performance_frequency()

// ## Hints

// Set a configuration hint. Most are read when the thing they configure is created, so a hint set
// after the window exists may do nothing.
set_hint(name: string, value: string) -> bool
    val n = cstring(name)
    val v = cstring(value)

    c.set_hint(n.ptr, v.ptr)
end set_hint

// Return a hint to its default, as though `set_hint` had never been called for it. Not the same as
// setting it to `""`, which is a value like any other.
reset_hint(name: string) -> bool
    val n = cstring(name)

    c.reset_hint(n.ptr)
end reset_hint

// Whether the caller is on the thread SDL was initialised on — the only one that may create a
// window, touch a renderer, or pump events. Worth asserting at the head of anything a worker thread
// has to hand off rather than do itself.
is_main_thread() -> bool = c.is_main_thread()

// Hand a URL to whatever the system opens it with — a browser for `https:`, a mail client for
// `mailto:`, the file manager for `file:`. This is how a link in an interface works, since a program
// drawing its own pixels has no link for the platform to notice.
//
// **`true` means the system accepted it, not that the user saw anything.** On a phone the program is
// backgrounded by the act of opening one, so the lifecycle events fire; on a desktop the window may
// simply lose focus. Nothing comes back either way.
open_url(url: string) -> bool
    val u = cstring(url)

    c.open_url(u.ptr)
end open_url

// A hint's name is a string rather than a number, so these are the one group of SDL's constants
// `c const` cannot answer for — `15 §7` refuses a string from C deliberately, since it would have
// to be written with two quotings for one value.
val HINT_RENDER_VSYNC: string = "SDL_RENDER_VSYNC"
val HINT_RENDER_DRIVER: string = "SDL_RENDER_DRIVER"
val HINT_VIDEO_DRIVER: string = "SDL_VIDEO_DRIVER"

// Selects a file-dialog backend by name. Only Linux has more than one to choose between — "portal"
// and "zenity"; every other platform has exactly one and **fails the dialog** if this is set to
// anything at all. That makes it the way to exercise a dialog's whole path — filters, properties,
// callback — with no panel appearing, which is what `tests.sysl` uses it for.
val HINT_FILE_DIALOG_DRIVER: string = "SDL_FILE_DIALOG_DRIVER"

// ## Colour

// An RGBA colour, one byte per channel.
//
// This is `SDL_Color`, laid out to agree with C's, and it crosses **by value** — which is what the
// text binding's render calls take. `tests.sysl` checks both the size and that the channels arrive
// in the right order after a round trip through a real render.
//
// It is declared here rather than in `c` because nothing in *this* package's C surface takes one:
// `SDL_SetRenderDrawColor` takes four bytes. The companion packages that do take an `SDL_Color`
// name this one.
struct Color
    r: u8
    g: u8
    b: u8
    a: u8

    // Each channel as a fraction of full scale, which is what `SDL_FColor` and therefore every
    // vertex wants.
    rf -> f32 = f32(self.r) / 255.0
    gf -> f32 = f32(self.g) / 255.0
    bf -> f32 = f32(self.b) / 255.0
    af -> f32 = f32(self.a) / 255.0
end Color

// An opaque colour.
rgb(r: u8, g: u8, b: u8) -> Color = Color(r, g, b, 255)

// A colour with an alpha channel.
rgba(r: u8, g: u8, b: u8, a: u8) -> Color = Color(r, g, b, a)

// An opaque colour from a packed `0xRRGGBB`, which is how a colour is usually written down.
color_from_rgb(v: u32) -> Color = Color(u8((v >> 16) & 0xff), u8((v >> 8) & 0xff), u8(v & 0xff), 255)

// Linear interpolation from `a` at `t = 0` to `b` at `t = 1`, clamped outside that — what a fade or
// a trail blending toward the background is written with.
blend(a: Color, b: Color, t: f64) -> Color
    val u = if t < 0.0 then 0.0 else if t > 1.0 then 1.0 else t

    Color(
        u8(f64(a.r) + (f64(b.r) - f64(a.r)) * u),
        u8(f64(a.g) + (f64(b.g) - f64(a.g)) * u),
        u8(f64(a.b) + (f64(b.b) - f64(a.b)) * u),
        u8(f64(a.a) + (f64(b.a) - f64(a.a)) * u),
    )
end blend

val BLACK: Color = Color(0, 0, 0, 255)
val WHITE: Color = Color(255, 255, 255, 255)
