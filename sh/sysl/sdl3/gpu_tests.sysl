module sh.sysl.sdl3
@tests

import sh.sysl.sdl3.c
import sysl.raw.ptr_cast
import sysl.buf.{Buf, buf}
import sysl.process

// SDL_GPU, against a real GPU device.
//
// **No test here opens a window.** A GPU device needs none, and everything drawn goes into a texture
// that is then copied into a transfer buffer and read back, so what is asserted is the pixels the GPU
// produced and not anything that crossed a display. The shaders are Metal Shading Language source,
// so the render tests need a Metal device; where `SDL_CreateGPUDevice` finds none they fail with
// SDL's reason, which is the right answer on a machine that cannot run them.
//
// **The render is chosen to make depth the only thing that can decide the overlap.** Two triangles of
// different colours cover overlapping bands of a 64 by 64 target; with the depth test on the nearer
// one must win the overlap whichever is drawn first, and with it off the one drawn last wins — which
// is the mutation that proves the test can fail. Colours use only 0.0 and 1.0 channels, so every
// expected byte is exact.

val WIDTH: u32 = 64
val HEIGHT: u32 = 64

val SHADERS: string = raw"""
#include <metal_stdlib>
using namespace metal;

struct VertexIn {
    float3 position [[attribute(0)]];
    float4 color [[attribute(1)]];
};

struct VertexOut {
    float4 position [[position]];
    float4 color;
};

vertex VertexOut vertex_main(VertexIn in [[stage_in]]) {
    VertexOut out;
    out.position = float4(in.position, 1.0);
    out.color = in.color;
    return out;
}

fragment float4 fragment_main(VertexOut in [[stage_in]]) {
    return in.color;
}
"""

// Whether this process is inside the macOS desktop session. Outside it, starting the platform's video
// driver can block for ever instead of failing, so this is asked before SDL is started.
in_desktop_session() -> bool
    process.capture("/bin/launchctl", ["managername"]) match
        Ok(out) -> out.text.starts_with("Aqua")
        Err(e) -> false
end in_desktop_session

// A Metal device. SDL_GPU needs the video subsystem up, and `headless` brings it up on the dummy
// driver, so no window server is involved and no window is made.
test_device() -> &GpuDevice
    assert(in_desktop_session(), "the GPU tests need a shell inside the desktop session")
    assert(init(INIT_VIDEO), "SDL starts: " + error())

    gpu_device(GPU_SHADERFORMAT_MSL, true).unwrap()
end test_device

// ## Layout

// The create-infos are read by SDL as C structs, so a field in the wrong place is a corrupted call
// and not a compile error. These are the sizes clang computes for the same declarations.
@test
the_gpu_layouts_agree_with_c()
    assert_eq(sizeof(c.GPUShaderCreateInfo), 56usize, "SDL_GPUShaderCreateInfo")
    assert_eq(sizeof(c.GPUGraphicsPipelineCreateInfo), 168usize, "SDL_GPUGraphicsPipelineCreateInfo")
    assert_eq(sizeof(c.GPUTextureCreateInfo), 36usize, "SDL_GPUTextureCreateInfo")
    assert_eq(sizeof(c.GPUBufferCreateInfo), 12usize, "SDL_GPUBufferCreateInfo")
    assert_eq(sizeof(c.GPUTransferBufferCreateInfo), 12usize, "SDL_GPUTransferBufferCreateInfo")
    assert_eq(sizeof(c.GPUSamplerCreateInfo), 52usize, "SDL_GPUSamplerCreateInfo")
    assert_eq(sizeof(c.GPUColorTargetInfo), 64usize, "SDL_GPUColorTargetInfo")
    assert_eq(sizeof(c.GPUDepthStencilTargetInfo), 32usize, "SDL_GPUDepthStencilTargetInfo")
    assert_eq(sizeof(c.GPUTextureTransferInfo), 24usize, "SDL_GPUTextureTransferInfo")
    assert_eq(sizeof(c.GPUTextureRegion), 40usize, "SDL_GPUTextureRegion")
    assert_eq(sizeof(c.GPUBufferBinding), 16usize, "SDL_GPUBufferBinding")
    assert_eq(sizeof(c.GPUVertexBufferDescription), 16usize, "SDL_GPUVertexBufferDescription")
    assert_eq(sizeof(c.GPUVertexAttribute), 16usize, "SDL_GPUVertexAttribute")
    assert_eq(sizeof(c.GPUVertexInputState), 32usize, "SDL_GPUVertexInputState")
    assert_eq(sizeof(c.GPURasterizerState), 28usize, "SDL_GPURasterizerState")
    assert_eq(sizeof(c.GPUMultisampleState), 12usize, "SDL_GPUMultisampleState")
    assert_eq(sizeof(c.GPUDepthStencilState), 44usize, "SDL_GPUDepthStencilState")
    assert_eq(sizeof(c.GPUColorTargetDescription), 36usize, "SDL_GPUColorTargetDescription")
    assert_eq(sizeof(c.GPUColorTargetBlendState), 32usize, "SDL_GPUColorTargetBlendState")
    assert_eq(sizeof(c.GPUGraphicsPipelineTargetInfo), 24usize, "SDL_GPUGraphicsPipelineTargetInfo")
    assert_eq(sizeof(c.GPUStencilOpState), 16usize, "SDL_GPUStencilOpState")
    assert_eq(sizeof(c.GPUTransferBufferLocation), 16usize, "SDL_GPUTransferBufferLocation")
    assert_eq(sizeof(c.GPUBufferRegion), 16usize, "SDL_GPUBufferRegion")
    assert_eq(sizeof(c.GPUTextureSamplerBinding), 16usize, "SDL_GPUTextureSamplerBinding")
    assert_eq(sizeof(c.GPUViewport), 24usize, "SDL_GPUViewport")
    assert_eq(sizeof(c.GPUTextureLocation), 32usize, "SDL_GPUTextureLocation")
    assert_eq(sizeof(c.GPUBufferLocation), 16usize, "SDL_GPUBufferLocation")
    assert_eq(sizeof(c.FColor), 16usize, "SDL_FColor")

// **Every field of every GPU struct sits where clang puts it.** A size cannot see a field of the wrong
// width when the padding makes up the difference — `color_write_mask` as a `u32` left the struct 32
// bytes and moved `enable_blend` into padding, so a pipeline asked for blending and got none. The
// numbers are `offsetof` in `SDL_gpu.h` as clang lays it out (SDL 3.4); the sysl name is the header's
// with `type` spelled `kind`.
@test
every_gpu_field_is_where_c_puts_it()
    assert_eq(offsetof(c.FColor, r), 0, "FColor.r")
    assert_eq(offsetof(c.FColor, g), 4, "FColor.g")
    assert_eq(offsetof(c.FColor, b), 8, "FColor.b")
    assert_eq(offsetof(c.FColor, a), 12, "FColor.a")

    assert_eq(offsetof(c.GPUShaderCreateInfo, code_size), 0, "GPUShaderCreateInfo.code_size")
    assert_eq(offsetof(c.GPUShaderCreateInfo, code), 8, "GPUShaderCreateInfo.code")
    assert_eq(offsetof(c.GPUShaderCreateInfo, entrypoint), 16, "GPUShaderCreateInfo.entrypoint")
    assert_eq(offsetof(c.GPUShaderCreateInfo, format), 24, "GPUShaderCreateInfo.format")
    assert_eq(offsetof(c.GPUShaderCreateInfo, stage), 28, "GPUShaderCreateInfo.stage")
    assert_eq(offsetof(c.GPUShaderCreateInfo, num_samplers), 32, "GPUShaderCreateInfo.num_samplers")
    assert_eq(offsetof(c.GPUShaderCreateInfo, num_storage_textures), 36, "GPUShaderCreateInfo.num_storage_textures")
    assert_eq(offsetof(c.GPUShaderCreateInfo, num_storage_buffers), 40, "GPUShaderCreateInfo.num_storage_buffers")
    assert_eq(offsetof(c.GPUShaderCreateInfo, num_uniform_buffers), 44, "GPUShaderCreateInfo.num_uniform_buffers")
    assert_eq(offsetof(c.GPUShaderCreateInfo, props), 48, "GPUShaderCreateInfo.props")

    assert_eq(offsetof(c.GPUTextureCreateInfo, kind), 0, "GPUTextureCreateInfo.type")
    assert_eq(offsetof(c.GPUTextureCreateInfo, format), 4, "GPUTextureCreateInfo.format")
    assert_eq(offsetof(c.GPUTextureCreateInfo, usage), 8, "GPUTextureCreateInfo.usage")
    assert_eq(offsetof(c.GPUTextureCreateInfo, width), 12, "GPUTextureCreateInfo.width")
    assert_eq(offsetof(c.GPUTextureCreateInfo, height), 16, "GPUTextureCreateInfo.height")
    assert_eq(offsetof(c.GPUTextureCreateInfo, layer_count_or_depth), 20, "GPUTextureCreateInfo.layer_count_or_depth")
    assert_eq(offsetof(c.GPUTextureCreateInfo, num_levels), 24, "GPUTextureCreateInfo.num_levels")
    assert_eq(offsetof(c.GPUTextureCreateInfo, sample_count), 28, "GPUTextureCreateInfo.sample_count")
    assert_eq(offsetof(c.GPUTextureCreateInfo, props), 32, "GPUTextureCreateInfo.props")

    assert_eq(offsetof(c.GPUBufferCreateInfo, usage), 0, "GPUBufferCreateInfo.usage")
    assert_eq(offsetof(c.GPUBufferCreateInfo, size), 4, "GPUBufferCreateInfo.size")
    assert_eq(offsetof(c.GPUBufferCreateInfo, props), 8, "GPUBufferCreateInfo.props")

    assert_eq(offsetof(c.GPUTransferBufferCreateInfo, usage), 0, "GPUTransferBufferCreateInfo.usage")
    assert_eq(offsetof(c.GPUTransferBufferCreateInfo, size), 4, "GPUTransferBufferCreateInfo.size")
    assert_eq(offsetof(c.GPUTransferBufferCreateInfo, props), 8, "GPUTransferBufferCreateInfo.props")

    assert_eq(offsetof(c.GPUSamplerCreateInfo, min_filter), 0, "GPUSamplerCreateInfo.min_filter")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, mag_filter), 4, "GPUSamplerCreateInfo.mag_filter")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, mipmap_mode), 8, "GPUSamplerCreateInfo.mipmap_mode")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, address_mode_u), 12, "GPUSamplerCreateInfo.address_mode_u")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, address_mode_v), 16, "GPUSamplerCreateInfo.address_mode_v")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, address_mode_w), 20, "GPUSamplerCreateInfo.address_mode_w")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, mip_lod_bias), 24, "GPUSamplerCreateInfo.mip_lod_bias")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, max_anisotropy), 28, "GPUSamplerCreateInfo.max_anisotropy")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, compare_op), 32, "GPUSamplerCreateInfo.compare_op")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, min_lod), 36, "GPUSamplerCreateInfo.min_lod")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, max_lod), 40, "GPUSamplerCreateInfo.max_lod")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, enable_anisotropy), 44, "GPUSamplerCreateInfo.enable_anisotropy")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, enable_compare), 45, "GPUSamplerCreateInfo.enable_compare")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, padding1), 46, "GPUSamplerCreateInfo.padding1")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, padding2), 47, "GPUSamplerCreateInfo.padding2")
    assert_eq(offsetof(c.GPUSamplerCreateInfo, props), 48, "GPUSamplerCreateInfo.props")

    assert_eq(offsetof(c.GPUVertexBufferDescription, slot), 0, "GPUVertexBufferDescription.slot")
