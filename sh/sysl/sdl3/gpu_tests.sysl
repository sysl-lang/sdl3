// ## The device

@test
a_device_needs_no_window()
    val dev = test_device()

    assert(dev.driver() != "", "the device names its driver")
    assert((dev.shader_formats() & GPU_SHADERFORMAT_MSL) != 0, "and accepts the MSL it was asked for")
    assert(dev.supports_texture(GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, GPU_TEXTUREUSAGE_COLOR_TARGET),
            "an RGBA8 colour target is supported")
    assert(dev.supports_texture(GPU_TEXTUREFORMAT_D16_UNORM, GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET),
            "and a 16-bit depth target")
    assert(gpu_driver_count() > 0, "SDL has drivers")
    assert(gpu_driver_name(0) != "", "and names them")

// ## The error path

@test
a_shader_that_does_not_compile_is_an_error_carrying_sdls_message()
    val dev = test_device()

    dev.shader("this is not shading language", GPU_SHADERFORMAT_MSL, GPU_SHADERSTAGE_VERTEX,
            "vertex_main") match
        Err(e) -> assert(e.contains("expected unqualified-id"), "the compiler's own diagnostic: " + e)
        Ok(s) -> assert(false, "garbage source made a shader")

@test
an_entry_point_that_is_not_there_is_an_error()
    val dev = test_device()

    dev.shader(SHADERS, GPU_SHADERFORMAT_MSL, GPU_SHADERSTAGE_VERTEX, "no_such_function") match
        Err(e) -> assert(e.contains("MTLFunction"), "the driver's own message: " + e)
        Ok(s) -> assert(false, "a missing entry point made a shader")

@test
a_format_the_device_does_not_take_is_an_error()
    val dev = test_device()

    dev.shader(SHADERS, GPU_SHADERFORMAT_SPIRV, GPU_SHADERSTAGE_VERTEX, "vertex_main") match
        Err(e) -> assert(e.contains("format"), "and says it is the format: " + e)
        Ok(s) -> assert(false, "SPIR-V was accepted by a Metal device")

@test
a_device_for_a_format_nothing_supports_is_an_error()
    assert(headless(), "SDL starts headless: " + error())

    gpu_device(0) match
        Err(e) -> assert(e.len > 0, "SDL says why: " + e)
        Ok(d) -> assert(false, "a device was made for no shader format at all")

// ## Rendering

// `p[i]` as an f32 store: the transfer buffer is bytes and a vertex is seven floats.
put_vertex(p: *f32, n: usize, x: f32, y: f32, z: f32, r: f32, g: f32, b: f32)
    val at = n * 7

    p[at] = x
    p[at + 1] = y
    p[at + 2] = z
    p[at + 3] = r
    p[at + 4] = g
    p[at + 5] = b
    p[at + 6] = 1.0

// Draw the two overlapping triangles into a 64 by 64 RGBA target cleared to blue and read it back.
//
// The red triangle (A) is nearer, at depth 0.25, and covers x + y <= 0.4 within the square from
// -0.9; the green (B) is farther, at 0.75, and covers x + y >= -0.4 up to 0.9. They overlap in the
// band between, and `a_first` chooses which is drawn first.
render_scene(dev: &GpuDevice, a_first: bool, depth_test: bool) -> Buf[u8]
    val vs = dev.shader(SHADERS, GPU_SHADERFORMAT_MSL, GPU_SHADERSTAGE_VERTEX, "vertex_main").unwrap()
    val fs = dev.shader(SHADERS, GPU_SHADERFORMAT_MSL, GPU_SHADERSTAGE_FRAGMENT, "fragment_main").unwrap()
    val buffers = [vertex_buffer(0, 28)]
    val attributes = [vertex_attribute(0, 0, GPU_VERTEXELEMENTFORMAT_FLOAT3, 0),
            vertex_attribute(1, 0, GPU_VERTEXELEMENTFORMAT_FLOAT4, 12)]
    val pipeline = dev.pipeline(vs, fs, buffers, attributes,
            GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, depth_format = GPU_TEXTUREFORMAT_D16_UNORM,
            depth_test = depth_test).unwrap()

    val color = dev.texture(GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, GPU_TEXTUREUSAGE_COLOR_TARGET, WIDTH,
            HEIGHT).unwrap()
    val depth = dev.texture(GPU_TEXTUREFORMAT_D16_UNORM, GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET, WIDTH,
            HEIGHT).unwrap()

    val vertex_bytes: u32 = 6 * 28
    val vertices = dev.buffer(GPU_BUFFERUSAGE_VERTEX, vertex_bytes).unwrap()
    val staging = dev.transfer_buffer(GPU_TRANSFERBUFFERUSAGE_UPLOAD, vertex_bytes).unwrap()
    val readback = dev.transfer_buffer(GPU_TRANSFERBUFFERUSAGE_DOWNLOAD, WIDTH * HEIGHT * 4).unwrap()

    val p: *f32 = ptr_cast(staging.map())

    put_vertex(p, 0, -0.9, -0.9, 0.25, 1.0, 0.0, 0.0)
    put_vertex(p, 1, 1.3, -0.9, 0.25, 1.0, 0.0, 0.0)
    put_vertex(p, 2, -0.9, 1.3, 0.25, 1.0, 0.0, 0.0)
    put_vertex(p, 3, 0.9, 0.9, 0.75, 0.0, 1.0, 0.0)
    put_vertex(p, 4, -1.3, 0.9, 0.75, 0.0, 1.0, 0.0)
    put_vertex(p, 5, 0.9, -1.3, 0.75, 0.0, 1.0, 0.0)
    staging.unmap()

    val cmd = dev.command_buffer().unwrap()
    val copy = cmd.copy_pass().unwrap()

    copy.upload_buffer(staging, vertices, vertex_bytes)
    copy.finish()

    val pass = cmd.render_pass_depth([color_target_clear(color, 0.0, 0.0, 1.0, 1.0)],
            depth_target_clear(depth, 1.0)).unwrap()

    pass.bind_pipeline(pipeline)
    pass.bind_vertex_buffer(0, vertices)

    if a_first then
        pass.draw(3, first_vertex = 0)
        pass.draw(3, first_vertex = 3)
    else
        pass.draw(3, first_vertex = 3)
        pass.draw(3, first_vertex = 0)

    pass.finish()

    val out = cmd.copy_pass().unwrap()

    out.download_texture(color, readback)
    out.finish()

    val fence = cmd.submit_with_fence(dev).unwrap()

    assert(fence.wait(), "the GPU finished")

    val bytes: *u8 = readback.map()
    var pixels: Buf[u8] = buf()

    for i in 0..<usize(WIDTH * HEIGHT * 4)
        pixels.push(bytes[i])

    readback.unmap()
    pixels
end render_scene

check_pixel(pixels: Buf[u8], x: usize, y: usize, r: u8, g: u8, b: u8, what: string)
    val at = (y * usize(WIDTH) + x) * 4

    assert_eq(pixels[at], r, what + ": red at " + x.to_string() + "," + y.to_string())
    assert_eq(pixels[at + 1], g, what + ": green at " + x.to_string() + "," + y.to_string())
    assert_eq(pixels[at + 2], b, what + ": blue at " + x.to_string() + "," + y.to_string())
    assert_eq(pixels[at + 3], u8(255), what + ": alpha at " + x.to_string() + "," + y.to_string())

// The nearer triangle wins the overlap, and the order of the draws does not matter.
check_depth_scene(pixels: Buf[u8])
    check_pixel(pixels, 0, 0, 0, 0, 255, "the background is the clear colour")
    check_pixel(pixels, 63, 63, 0, 0, 255, "the background, opposite corner")
    check_pixel(pixels, 63, 0, 0, 0, 255, "the background, third corner")
    check_pixel(pixels, 0, 63, 0, 0, 255, "the background, fourth corner")
    check_pixel(pixels, 13, 51, 255, 0, 0, "the red triangle alone")
    check_pixel(pixels, 51, 13, 0, 255, 0, "the green triangle alone")
    check_pixel(pixels, 32, 32, 255, 0, 0, "the nearer red wins the overlap's middle")
    check_pixel(pixels, 24, 32, 255, 0, 0, "and its left part")
    check_pixel(pixels, 40, 32, 255, 0, 0, "and its right part")

@test
the_nearer_triangle_wins_when_it_is_drawn_first()
    val dev = test_device()

    check_depth_scene(render_scene(dev, true, true))

@test
the_nearer_triangle_wins_when_it_is_drawn_last()
    val dev = test_device()

    check_depth_scene(render_scene(dev, false, true))

// Without the test the draw order decides, which is what makes the two tests above evidence of the
// depth buffer rather than of the draw order.
@test
without_the_depth_test_the_last_draw_wins()
    val dev = test_device()
    val a_last = render_scene(dev, false, false)
    val b_last = render_scene(dev, true, false)

    check_pixel(a_last, 32, 32, 255, 0, 0, "red drawn last covers the overlap")
    check_pixel(b_last, 32, 32, 0, 255, 0, "green drawn last covers the overlap")
    check_pixel(b_last, 0, 0, 0, 0, 255, "the background is still the clear colour")

// ## Blending

// Half-transparent red over a blue target, in either state of a pipeline's `blend`. SDL's write mask is
// one byte, so a wider one in the binding would leave `blend` in the padding and blending off.
render_translucent(dev: &GpuDevice, blend: bool) -> Buf[u8]
    val vs = dev.shader(SHADERS, GPU_SHADERFORMAT_MSL, GPU_SHADERSTAGE_VERTEX, "vertex_main").unwrap()
    val fs = dev.shader(SHADERS, GPU_SHADERFORMAT_MSL, GPU_SHADERSTAGE_FRAGMENT, "fragment_main").unwrap()
    val pipeline = dev.pipeline(vs, fs, [vertex_buffer(0, 28)],
            [vertex_attribute(0, 0, GPU_VERTEXELEMENTFORMAT_FLOAT3, 0),
             vertex_attribute(1, 0, GPU_VERTEXELEMENTFORMAT_FLOAT4, 12)],
            GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, blend = blend).unwrap()
    val color = dev.texture(GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, GPU_TEXTUREUSAGE_COLOR_TARGET, WIDTH, HEIGHT).unwrap()
    val vertices = dev.buffer(GPU_BUFFERUSAGE_VERTEX, 3 * 28).unwrap()
    val staging = dev.transfer_buffer(GPU_TRANSFERBUFFERUSAGE_UPLOAD, 3 * 28).unwrap()
    val readback = dev.transfer_buffer(GPU_TRANSFERBUFFERUSAGE_DOWNLOAD, WIDTH * HEIGHT * 4).unwrap()
    val p: *f32 = ptr_cast(staging.map())

    put_vertex(p, 0, -3.0, -3.0, 0.5, 1.0, 0.0, 0.0)
    put_vertex(p, 1, 3.0, -3.0, 0.5, 1.0, 0.0, 0.0)
    put_vertex(p, 2, 0.0, 3.0, 0.5, 1.0, 0.0, 0.0)

    for n in 0..<3usize do p[n * 7 + 6] = 0.5

    staging.unmap()

    val cmd = dev.command_buffer().unwrap()
    val copy = cmd.copy_pass().unwrap()

    copy.upload_buffer(staging, vertices, 3 * 28)
    copy.finish()

    val pass = cmd.render_pass([color_target_clear(color, 0.0, 0.0, 1.0, 1.0)]).unwrap()

    pass.bind_pipeline(pipeline)
    pass.bind_vertex_buffer(0, vertices)
    pass.draw(3)
    pass.finish()

    val out = cmd.copy_pass().unwrap()

    out.download_texture(color, readback)
    out.finish()
    assert(cmd.submit_with_fence(dev).unwrap().wait(), "the GPU finished")

    val bytes: *u8 = readback.map()
    var pixels: Buf[u8] = buf()

    for i in 0..<usize(WIDTH * HEIGHT * 4) do pixels.push(bytes[i])

    readback.unmap()
    pixels
end render_translucent

@test
a_pipeline_with_blend_mixes_by_the_source_alpha()
    val pixels = render_translucent(test_device(), true)
    val at = (32usize * usize(WIDTH) + 32usize) * 4

    assert(pixels[at] >= 126 && pixels[at] <= 129, "half of the red")
    assert(pixels[at + 2] >= 126 && pixels[at + 2] <= 129, "and half of the blue under it")

@test
a_pipeline_without_blend_overwrites()
    check_pixel_rgb(render_translucent(test_device(), false))

private check_pixel_rgb(pixels: Buf[u8])
    val at = (32usize * usize(WIDTH) + 32usize) * 4

    assert_eq(pixels[at], u8(255), "all of the red")
    assert_eq(pixels[at + 2], u8(0), "and none of the blue")

// ## The 2D renderer on a device

// A GPU texture cleared to one colour, usable both as a target and by the renderer.
cleared(dev: &GpuDevice, r: f32, g: f32, b: f32) -> &GpuTexture
    val color = dev.texture(GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
            GPU_TEXTUREUSAGE_COLOR_TARGET | GPU_TEXTUREUSAGE_SAMPLER, 2, 1).unwrap()
    val cmd = dev.command_buffer().unwrap()

    cmd.render_pass([color_target_clear(color, r, g, b, 1.0)]).unwrap().finish()
    cmd.submit()
    color
end cleared

// Reading back through the renderer, so this is the whole 2D path on the device rather than the texture
// alone: a 3D pass's output, seen by the renderer without a copy.
@test
a_renderer_with_no_window_draws_a_gpu_textures_pixels()
    val dev = test_device()
    val renderer = offscreen_gpu_renderer(dev).unwrap()
    val target = renderer.create_texture(PixelFormat.Argb8888, TextureAccess.Target, 2, 1).unwrap()
    val color = cleared(dev, 1.0, 0.0, 0.0)
    val view = gpu_texture_view(renderer, color, PixelFormat.Abgr8888).unwrap()

    assert(gpu_renderer_device(renderer).is_some(), "the renderer says which device it is on")
    assert(renderer.set_target(target), error())
    renderer.copy(view)

    val back = renderer.read_pixels().unwrap()

    assert_eq(back.read_pixel(1, 0).unwrap().r, 255u8, "red, not swapped with blue")
    assert_eq(back.read_pixel(1, 0).unwrap().b, 0u8, "no blue")
    renderer.present()
end a_renderer_with_no_window_draws_a_gpu_textures_pixels

// Half-covering white over pure blue. `Blend` would multiply by the alpha a second time and give 64 in
// red, so this result can only come from the premultiplied equation.
@test
premultiplied_pixels_composite_once()
    val dev = test_device()
    val renderer = offscreen_gpu_renderer(dev).unwrap()
    val target = renderer.create_texture(PixelFormat.Argb8888, TextureAccess.Target, 2, 1).unwrap()
    val under = gpu_texture_view(renderer, cleared(dev, 0.0, 0.0, 1.0), PixelFormat.Abgr8888).unwrap()
    val over = renderer.create_texture(PixelFormat.Argb8888, TextureAccess.Streaming, 2, 1).unwrap()
    val px = create_surface(2, 1, PixelFormat.Argb8888).unwrap()

    px.write_pixel(0, 0, Color(128, 128, 128, 128))
    px.write_pixel(1, 0, Color(0, 0, 0, 0))
    over.update(px.pixels(), px.pitch())
    assert(over.set_blend_mode(BlendMode.Premultiplied), error())
    renderer.set_target(target)
    renderer.copy(under)
    renderer.copy(over)

    val back = renderer.read_pixels().unwrap()
    val soft = back.read_pixel(0, 0).unwrap()
    val hole = back.read_pixel(1, 0).unwrap()

    assert_eq(soft.r, 128u8, "the half-covered red is the source's own")
    assert_eq(soft.b, 255u8, "and blue is the source's plus the rest of what was under it")
    assert_eq(hole.r, 0u8, "nothing over the hole")
    assert_eq(hole.b, 255u8, "so what was under it shows")
    renderer.present()
end premultiplied_pixels_composite_once

@test
a_surface_converts_between_formats()
    assert(headless(), "SDL starts headless: " + error())

    val s = create_surface(1, 1, PixelFormat.Abgr8888).unwrap()

    s.write_pixel(0, 0, Color(10, 20, 30, 40))

    val out = s.convert(PixelFormat.Argb8888).unwrap()

    assert(out.format() == PixelFormat.Argb8888, "the format asked for")
    assert_eq(out.pixels()[0], 30u8, "ARGB is blue first in memory")
    assert_eq(out.read_pixel(0, 0).unwrap().a, 40u8, "and the alpha survives")
end a_surface_converts_between_formats

@test
the_premultiplied_blend_mode_is_sdls()
    assert_eq(BlendMode.Premultiplied.code(), 16u32, "SDL_BLENDMODE_BLEND_PREMULTIPLIED")
