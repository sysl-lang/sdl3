module sh.sysl.sdl3

import sh.sysl.sdl3.c
import sysl.slices.as_ptr
import sysl.text.from_cstring

// Audio playback, on the queue model.
//
// **SDL runs its own audio thread and pulls from a stream's queue**, which is what opening a device
// stream with a null callback selects. The program synthesises or decodes a finished buffer and
// pushes it; nothing of this package is ever called from SDL's audio thread.
//
// **That is a deliberate choice and not a limitation of the binding.** SDL's other model hands the
// device a callback it invokes on its own thread, and a sysl closure called from a thread sysl did
// not start would be adjusting reference counts outside anything this package has established the
// atomicity of. The queue model asks that question of nobody, costs a buffer's latency, and is what
// every use short of a synthesiser wants. The mixer package is the answer for the rest.
//
// Opening several streams on the default device is fine and is how overlapping effects play at
// once — SDL mixes them.

// What a sample looks like.
enum AudioFormat
    // 32-bit little-endian float samples in [-1, 1], the natural format for synthesised PCM.
    F32

    // Signed 16-bit samples, what most files decode to.
    S16

    code(self) -> i32
        self match
            F32 -> AUDIO_F32
            S16 -> AUDIO_S16

    // SDL's own name for it — "SDL_AUDIO_F32LE" — which is a useful thing to print because it says
    // the byte order the value carries and this name does not.
    name(self) -> string = from_cstring(c.get_audio_format_name(self.code())).unwrap_or("")
end AudioFormat

impl Display for AudioFormat
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            F32 -> "f32"
            S16 -> "s16"

        display_str(s, out, fmt)

// A playback voice: samples go in, the device takes them out.
struct AudioStream
    handle: *c.AudioStream

    resume(&self) -> bool = c.resume_audio_stream_device(self.handle)

    pause(&self) -> bool = c.pause_audio_stream_device(self.handle)

    // Queue float samples, each in [-1, 1]. **SDL copies them synchronously**, so the slice may be
    // reused or dropped the moment this returns — which is why there is no staging buffer here.
    put(&self, samples: []f32) -> bool
        if samples.len == 0 then return true

        c.put_audio_stream_data(self.handle, ptr_cast(as_ptr(samples)), i32(samples.len * 4))
    end put

    // Queue bytes already in the stream's own sample format — a decoder's buffer handed through
    // with no intermediate array.
    put_bytes(&self, bytes: []u8) -> bool
        if bytes.len == 0 then return true

        c.put_audio_stream_data(self.handle, as_ptr(bytes), i32(bytes.len))
    end put_bytes

    // Bytes still queued and not yet taken by the device. Zero means the voice is idle, which is
    // how a player picks a free stream rather than cutting off a sound still playing.
    queued(&self) -> i32 = c.get_audio_stream_queued(self.handle)

    // Hand over whatever partial sample frame is buffered, so the tail of a sound is not held back
    // waiting for more. For the end of a clip, not for every push.
    flush(&self) -> bool = c.flush_audio_stream(self.handle)

    clear(&self) -> bool = c.clear_audio_stream(self.handle)

    // Playback gain: 1.0 leaves the samples alone, 0.0 is silence, above 1.0 amplifies and may
    // clip. SDL applies it as it feeds the device, so a volume control costs nothing per sample.
    gain(&self) -> f32 = c.get_audio_stream_gain(self.handle)

    set_gain(&self, g: f32) -> bool = c.set_audio_stream_gain(self.handle, g)
end AudioStream

// The stream goes when the last reference does, which also closes the device it opened.
impl Drop for AudioStream
    drop(self) = c.destroy_audio_stream(self.handle)

// Bring up the audio subsystem. Independent of video, so a program may open its window first and
// decide about sound afterwards.
init_audio() -> bool = init_subsystem(INIT_AUDIO)

quit_audio() = quit_subsystem(INIT_AUDIO)

// Open a playback stream on the default device and start it. The default format is float samples,
// which is the natural shape for anything synthesised.
open_audio_stream(freq: i32, channels: i32 = 1,
                  format: AudioFormat = AudioFormat.F32) -> Option[&AudioStream]
    var spec = AudioSpec(format.code(), channels, freq)
    val s = c.open_audio_device_stream(AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, null, null)

    if s == null then return None

    val stream: &AudioStream = AudioStream(s)

    stream.resume()
    Some(stream)
end open_audio_stream
