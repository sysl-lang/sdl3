// Ask for a file through the system's own panel, and print what came back.
//
//     sysl build . --lib ../..
//
// Named by coordinate like any program of the package; `--lib ../..` builds it against this checkout.
package {
  name    = "file-dialog"
  version = "0.0.1"
  sysl    = "0.8.6"
}

dependencies {
  sdl3 { git = "github.com/sysl-lang/sdl3", version = "0.3.18" }
}

requires {
  os    = true
  posix = true
  heap  = true
}
